{
  "name": "infinity-operations",
  "type": "module",
  "version": "1.0.0",
  "description": "Infinity Operations Dashboard on Astro and Cloudflare Pages",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "start": "wrangler pages dev dist --port 8788",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "check": "astro check",
    "lint": "astro check",
    "test": "node --test tests/*.test.js",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
