---
import '../styles/global.css';

interface Props {
  title?: string;
  activeTab?: 'dashboard' | 'videos' | 'editors' | 'mis' | 'login';
}

const { title = 'Infinity Operations', activeTab = 'dashboard' } = Astro.props;
const isLoginPage = activeTab === 'login';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Infinity Operations</title>
    <meta name="description" content="Production Operations Dashboard for Video Production Pipelines." />
    <meta name="theme-color" content="#be185d" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Infinity Ops" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/infinity-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    {isLoginPage ? (
      <slot />
    ) : (
      <div class="app-container">
        <!-- Mobile backdrop -->
        <div id="sidebar-backdrop" class="sidebar-backdrop" onclick="toggleMobileSidebar()"></div>

        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="sidebar">
          <div class="sidebar-header">
            <div class="brand-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            </div>
            <div class="brand-info">
              <span class="brand-title">Infinity Ops</span>
              <span class="brand-subtitle">Control Tower</span>
            </div>
          </div>

          <nav class="sidebar-nav">
            <a href="/" class={`nav-link ${activeTab === 'dashboard' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                <rect x="14" y="14" width="7" height="7" rx="1.5" />
                <rect x="3" y="14" width="7" height="7" rx="1.5" />
              </svg>
              <span>Control Tower</span>
            </a>

            <a href="/videos" class={`nav-link ${activeTab === 'videos' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7" />
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
              </svg>
              <span>Videos</span>
            </a>

            <a href="/editor-load" class={`nav-link ${activeTab === 'editors' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
              <span>Editor Load</span>
            </a>

            <a href="/mis" class={`nav-link ${activeTab === 'mis' ? 'active' : ''}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 19V9" /><path d="M10 19V5" /><path d="M16 19v-7" /><path d="M22 19V3" />
              </svg>
              <span>Daily MIS</span>
            </a>
          </nav>

          <div class="sidebar-footer">
            <div class="status-pill">
              <span class="status-dot"></span>
              <span>Ops Pipeline Active</span>
            </div>
            <button id="logout-btn" class="logout-btn" onclick="handleLogout()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Log Out</span>
            </button>
          </div>
        </aside>

        <!-- Main Workspace -->
        <div class="main-content">
          <header class="top-bar">
            <div class="top-bar-left">
              <button class="mobile-menu-toggle" onclick="toggleMobileSidebar()" aria-label="Toggle navigation">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="3" y1="12" x2="21" y2="12" />
                  <line x1="3" y1="6" x2="21" y2="6" />
                  <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
              </button>
              <h1 class="page-heading">{title}</h1>
            </div>

            <div class="top-bar-right">
              <div id="refresh-indicator" class="refresh-indicator">
                <span id="last-updated-text">Loaded</span>
              </div>
              <button id="install-app-btn" class="btn btn-secondary btn-sm header-icon-btn" type="button" hidden aria-label="Install Infinity Operations">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 3v12" /><polyline points="7 10 12 15 17 10" /><path d="M5 21h14" />
                </svg>
                <span class="header-action-label">Install</span>
              </button>
              <button id="notification-bell-btn" class="btn btn-secondary btn-sm header-icon-btn notification-bell" type="button" aria-label="Open activity notifications" aria-expanded="false">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" />
                </svg>
                <span class="header-action-label">Alerts</span>
                <span id="notification-badge" class="notification-badge" hidden>0</span>
              </button>
              <button id="global-refresh-btn" class="btn btn-secondary btn-sm" onclick="triggerPageRefresh()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="23 4 23 10 17 10" />
                  <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                </svg>
                <span>Refresh</span>
              </button>
            </div>
          </header>

          <main class="content-body">
            <slot />
          </main>

          <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
            <a href="/" class={activeTab === 'dashboard' ? 'active' : ''}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Today
            </a>
            <a href="/videos" class={activeTab === 'videos' ? 'active' : ''}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3Z"/></svg>Videos
            </a>
            <a href="/editor-load" class={activeTab === 'editors' ? 'active' : ''}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1a6 6 0 0 1 12 0v1M17 5a3 3 0 0 1 0 6M19 14a5 5 0 0 1 2 4v2"/></svg>Editors
            </a>
            <a href="/mis" class={activeTab === 'mis' ? 'active' : ''}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20v-7M22 20V7"/></svg>MIS
            </a>
          </nav>
        </div>
      </div>
    )}

    <!-- Toast Notification Container -->
    <div id="toast-root" class="toast-container"></div>

    {!isLoginPage && (
      <aside id="notification-panel" class="notification-panel" aria-hidden="true">
        <div class="notification-panel-head">
          <div>
            <strong>Activity alerts</strong>
            <span id="notification-status-text">Checking notification support…</span>
          </div>
          <button id="notification-panel-close" class="notification-close-btn" type="button" aria-label="Close notifications">×</button>
        </div>
        <div class="notification-permission-card">
          <div>
            <strong>QC and Changes alerts</strong>
            <span>Receive an alert while this app is running.</span>
          </div>
          <button id="enable-notifications-btn" class="btn btn-primary btn-sm" type="button">Enable</button>
        </div>
        <div id="notification-feed" class="notification-feed"></div>
        <button id="clear-notifications-btn" class="notification-clear-btn" type="button">Clear activity</button>
      </aside>
    )}

    <script is:inline define:vars={{ isLoginPage }}>
      function isLoginRoute(pathname) {
        if (!pathname) return false;
        const clean = pathname.toLowerCase().replace(/\/+$/, '').split('?')[0] || '/';
        return clean === '/login';
      }

      function toggleMobileSidebar() {
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar) sidebar.classList.toggle('mobile-open');
        if (backdrop) backdrop.classList.toggle('mobile-open');
      }

      function showToast(message, type = 'info') {
        const root = document.getElementById('toast-root');
        if (!root) return;
        const toast = document.createElement('div');
        toast.className = `toast ${type === 'error' ? 'toast-error' : type === 'success' ? 'toast-success' : ''}`;
        toast.textContent = message;
        root.appendChild(toast);
        setTimeout(() => {
          toast.remove();
        }, 4000);
      }
      window.showToast = showToast;

      async function handleLogout() {
        try {
          await fetch('/api/auth/logout', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' }
          });
        } finally {
          if (!isLoginRoute(window.location.pathname)) {
            window.location.replace('/login');
          }
        }
      }

      function triggerPageRefresh() {
        if (typeof window.__refreshOperationsData === 'function') {
          window.__refreshOperationsData();
        }
      }

      // Check session on page load ONLY for protected pages (never for login page)
      (function() {
        if (isLoginPage || isLoginRoute(window.location.pathname)) {
          return;
        }

        let sessionChecked = false;
        fetch('/api/auth/session', {
          method: 'GET',
          credentials: 'same-origin',
          headers: { Accept: 'application/json' }
        })
          .then(res => res.json())
          .then(data => {
            if (sessionChecked) return;
            sessionChecked = true;
            if (!data || !data.authenticated) {
              const currentPath = window.location.pathname + window.location.search;
              if (!isLoginRoute(window.location.pathname)) {
                window.location.replace('/login?redirect=' + encodeURIComponent(currentPath));
              }
            }
          })
          .catch(() => {});
      })();
    </script>
    <script is:inline src="/notification-engine.js" defer></script>
  </body>
</html>
