---
// Video Detail Drawer & Detect RAW Confirmation Modal
---

<div id="video-drawer-backdrop" class="drawer-backdrop" onclick="closeVideoDrawer()"></div>

<div id="video-drawer" class="drawer">
  <div class="drawer-header">
    <div>
      <span style="font-size: 0.6875rem; text-transform: uppercase; font-weight: 700; color: var(--brand-700); letter-spacing: 0.05em;">Video Operations</span>
      <h2 id="drawer-video-id" class="font-mono" style="font-size: 1.1rem; font-weight: 700; color: var(--text-main); margin-top: 1px;">—</h2>
    </div>
    <button class="btn btn-secondary btn-sm" onclick="closeVideoDrawer()" aria-label="Close drawer" style="padding: 0.35rem 0.5rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <div id="drawer-loading" class="drawer-body" style="display: none;">
    <div class="skeleton skeleton-title"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-metric" style="margin-top: 0.75rem;"></div>
  </div>

  <div id="drawer-content" class="drawer-body">
    <!-- Title & Status Section -->
    <div style="display: flex; flex-direction: column; gap: 0.375rem;">
      <h3 id="drawer-title" style="font-size: 0.95rem; font-weight: 700; color: var(--text-main); line-height: 1.35;">—</h3>
      <div style="display: flex; gap: 0.375rem; flex-wrap: wrap; align-items: center;">
        <span id="drawer-status-chip" class="chip chip-default">—</span>
        <span id="drawer-sla-chip" class="chip chip-default" style="display: none;">—</span>
      </div>
    </div>

    <div class="mission-card" aria-label="Production mission progress">
      <div class="mission-head">
        <div id="drawer-mission-level" class="mission-level">LEVEL 1 OF 8</div>
        <div id="drawer-mission-next" class="mission-next">Next: Save script</div>
      </div>
      <div class="mission-track"><span id="drawer-mission-progress" style="width: 0%"></span></div>
      <div id="drawer-mission-steps" class="mission-steps"></div>
    </div>

    <div id="drawer-operational-alert" class="operational-alert" style="display:none;" role="alert">
      <div class="operational-alert-head">
        <strong id="drawer-operational-alert-title">Action required</strong>
        <span id="drawer-operational-alert-badge" class="chip chip-red">Issue</span>
      </div>
      <p id="drawer-operational-alert-text"></p>
      <small id="drawer-operational-alert-help">Open the QC section below, follow the instruction, upload the corrected FINAL file, then run Detect FINAL.</small>
    </div>

    <!-- Metadata Grid -->
    <div class="card" style="padding: 0.875rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; background: var(--bg-subtle);">
      <div>
        <div style="font-size: 0.6875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Teacher</div>
        <div id="drawer-teacher" style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main); margin-top: 2px;">—</div>
      </div>
      <div>
        <div style="font-size: 0.6875rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Assigned Editor</div>
        <div id="drawer-editor" style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main); margin-top: 2px;">—</div>
      </div>
    </div>

    <!-- Manager script workspace -->
    <div id="drawer-script-section" style="display: flex; flex-direction: column; gap: 0.375rem;">
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Content Workspace</span>
      <label class="manager-field">Video Type
        <select id="drawer-video-type"><option>Original Recording</option><option>Repurpose</option><option>Existing RAW</option></select>
      </label>
      <label class="manager-field">Recording Script <span style="font-weight:500;">— for the teacher</span>
        <textarea id="drawer-script-input" rows="6" placeholder="What the teacher should say, including hook and delivery cues..."></textarea>
      </label>
      <label class="manager-field">Editor Brief <span style="font-weight:500;">— sent with RAW</span>
        <textarea id="drawer-editor-brief-input" rows="6" placeholder="Source/timestamps, first frame, cuts, subtitles, SFX, duration and caption..."></textarea>
      </label>
      <div class="manager-action-grid">
        <button id="save-script-btn" class="btn btn-secondary" onclick="saveManagerScript()">Save Content</button>
        <button id="approve-script-btn" class="btn btn-primary" onclick="approveManagerScript()">Approve Content ✓</button>
      </div>
    </div>

    <!-- Assignment -->
    <div style="display:flex; flex-direction:column; gap:0.45rem;">
      <span style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Editor Assignment</span>
      <label class="manager-field">Editor
        <select id="drawer-editor-select"><option value="">Choose editor</option></select>
      </label>
      <button id="assign-editor-btn" class="btn btn-secondary" onclick="assignManagerEditor()">Assign / Reassign Editor</button>
    </div>

    <!-- Drive & External Assets Links -->
    <div style="display: flex; flex-direction: column; gap: 0.375rem;">
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Drive Assets & Communication</span>
      
      <div id="drawer-links-container" style="display: flex; flex-direction: column; gap: 0.375rem;">
        <div id="drawer-main-folder-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">Main Video Folder</span>
          <a id="drawer-main-folder-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--brand-700);">Open Drive ↗</a>
        </div>

        <div id="drawer-raw-folder-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">RAW Folder</span>
          <a id="drawer-raw-folder-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--brand-700);">Open Drive ↗</a>
        </div>

        <div id="drawer-raw-file-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">RAW Video File</span>
          <a id="drawer-raw-file-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--brand-700);">View File ↗</a>
        </div>

        <div id="drawer-final-folder-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">FINAL Folder</span>
          <a id="drawer-final-folder-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--brand-700);">Open Drive ↗</a>
        </div>

        <div id="drawer-final-file-row" style="display: none; align-items: center; justify-content: space-between; padding: 0.45rem 0.75rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-md);">
          <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">FINAL Video File</span>
          <a id="drawer-final-file-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="color: var(--brand-700);">View File ↗</a>
        </div>

        <div id="drawer-prince-whatsapp-row" class="handoff-row" style="display: none;">
          <div class="handoff-copy"><strong>Send RAW folder to Prince</strong><span>RAW coordinator · upload source files</span></div>
          <a id="drawer-prince-whatsapp-link" href="#" target="_blank" rel="noopener noreferrer" class="btn whatsapp-icon-btn" aria-label="WhatsApp RAW folder to Prince" title="WhatsApp Prince">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.84 9.84 0 0 0-8.5 14.78L2 22l5.36-1.5A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.06 8.06 0 0 1-4.1-1.12l-.3-.18-3.18.9.86-3.1-.2-.32A8.05 8.05 0 1 1 12.04 20Zm4.42-6.04c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2a7.25 7.25 0 0 1-1.34-1.66c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.2-.47-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28Z"/></svg>
          </a>
        </div>

        <div id="drawer-whatsapp-row" class="handoff-row" style="display: none;">
          <div class="handoff-copy"><strong>Message assigned editor</strong><span id="drawer-editor-whatsapp-caption">Send RAW and editing brief</span></div>
          <a id="drawer-whatsapp-link" href="#" target="_blank" rel="noopener noreferrer" class="btn whatsapp-icon-btn" aria-label="WhatsApp assigned editor" title="WhatsApp editor">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.84 9.84 0 0 0-8.5 14.78L2 22l5.36-1.5A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.06 8.06 0 0 1-4.1-1.12l-.3-.18-3.18.9.86-3.1-.2-.32A8.05 8.05 0 1 1 12.04 20Zm4.42-6.04c-.24-.12-1.43-.7-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2a7.25 7.25 0 0 1-1.34-1.66c-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.79-.2-.47-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.15-.06-.1-.22-.16-.46-.28Z"/></svg>
          </a>
        </div>

        <div id="drawer-no-links" style="font-size: 0.8125rem; color: var(--text-subtle); padding: 0.35rem 0;">No external asset links returned.</div>
      </div>
    </div>

    <!-- Timeline & Timestamps -->
    <div id="drawer-timeline-section" style="display: flex; flex-direction: column; gap: 0.375rem;">
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Pipeline Activity Dates</span>
      <div id="drawer-timeline-container" style="display: flex; flex-direction: column; gap: 0.25rem;">
        <!-- Filled dynamically -->
      </div>
    </div>

    <!-- Drive detection -->
    <div style="display:flex; flex-direction:column; gap:0.45rem;">
      <span style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Drive Detection</span>
      <div class="manager-action-grid">
        <button id="detect-raw-btn" class="btn btn-secondary" onclick="openDetectRawModal()">Detect RAW</button>
        <button id="detect-final-btn" class="btn btn-secondary" onclick="detectManagerFinal()">Detect FINAL</button>
      </div>
    </div>

    <!-- QC decision -->
    <div style="display:flex; flex-direction:column; gap:0.45rem;">
      <span style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">QC Decision</span>
      <label class="manager-field">Change notes (required for Changes)
        <textarea id="drawer-qc-notes" rows="3" placeholder="Explain exact changes for the editor..."></textarea>
      </label>
      <div class="manager-action-grid">
        <button id="qc-changes-btn" class="btn btn-secondary" onclick="submitManagerQcChanges()">Request Changes</button>
        <button id="qc-approve-btn" class="btn btn-primary" onclick="submitManagerQcApprove()">Approve QC ✓</button>
      </div>
    </div>

    <div id="manager-action-progress" class="manager-action-progress" style="display:none;" role="status" aria-live="polite">
      <div class="manager-action-progress-head">
        <strong id="manager-action-progress-title">Processing action…</strong>
        <span id="manager-action-progress-time">0s elapsed</span>
      </div>
      <div class="manager-action-progress-track"><span></span></div>
      <p id="manager-action-progress-note">Usually completes in 5–20 seconds. Keep this screen open.</p>
    </div>

    <!-- Publishing confirmation -->
    <div style="display:flex; flex-direction:column; gap:0.45rem;">
      <span style="font-size:0.75rem; font-weight:700; color:var(--text-muted); text-transform:uppercase;">Publishing Confirmation</span>
      <label class="manager-field">Account<input id="drawer-account" placeholder="Assigned account" /></label>
      <label class="manager-field">Published Post URL<input id="drawer-post-url" type="url" placeholder="https://instagram.com/reel/..." /></label>
      <button id="mark-uploaded-btn" class="btn btn-primary" onclick="markManagerUploaded()">Confirm Uploaded</button>
    </div>

    <div id="manager-action-message" style="display:none; padding:0.65rem 0.75rem; border-radius:var(--radius-md); font-size:0.8125rem;"></div>
  </div>

  <div class="drawer-footer">
    <span style="font-size:0.75rem; color:var(--text-muted);">All write actions are validated by the Apps Script workflow.</span>
  </div>
</div>

<!-- Confirmation Modal for Detect RAW -->
<div id="detect-raw-modal" class="modal-backdrop">
  <div class="modal-card">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--brand-100); color: var(--brand-700); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </div>
      <div>
        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-main);">Run RAW Video Detection?</h4>
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 2px;">This scans Google Drive for video <span id="modal-video-id" class="font-mono" style="font-weight: 700; color: var(--brand-700);"></span> and updates metadata.</p>
      </div>
    </div>

    <div id="modal-action-status" style="display: none; padding: 0.65rem 0.85rem; border-radius: var(--radius-md); font-size: 0.8125rem;"></div>

    <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
      <button id="modal-cancel-btn" class="btn btn-secondary" onclick="closeDetectRawModal()">Cancel</button>
      <button id="modal-confirm-btn" class="btn btn-primary" onclick="executeDetectRaw()">
        <span id="modal-confirm-text">Confirm & Run</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  let activeSelectedVideoId = '';
  let isDetectRawRunning = false;
  let isManagerActionRunning = false;
  let managerActionTimer = null;
  let editorOptionsLoaded = false;
  const videoDetailCache = new Map();
  const editorPhoneByName = new Map();
  const PRINCE_WHATSAPP = '918700996424';

  function openVideoDrawer(videoId) {
    if (!videoId || videoId === '—') return;
    activeSelectedVideoId = videoId;

    const drawer = document.getElementById('video-drawer');
    const backdrop = document.getElementById('video-drawer-backdrop');
    const loading = document.getElementById('drawer-loading');
    const content = document.getElementById('drawer-content');
    const drawerVideoId = document.getElementById('drawer-video-id');

    if (drawerVideoId) drawerVideoId.textContent = videoId;
    if (drawer) drawer.classList.add('open');
    if (backdrop) backdrop.classList.add('open');

    if (loading) loading.style.display = 'block';
    if (content) content.style.display = 'none';

    const cached = videoDetailCache.get(videoId);
    if (cached && Date.now() - cached.savedAt < 15000) {
      populateVideoDrawer(cached.data, videoId);
      return Promise.resolve(cached.data);
    }

    return fetch('/api/infinity', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'video', videoId: videoId })
    })
      .then(res => res.json())
      .then(resData => {
        videoDetailCache.set(videoId, { data: resData, savedAt: Date.now() });
        populateVideoDrawer(resData, videoId);
      })
      .catch(() => {
        showToast('Failed to load video details', 'error');
        if (loading) loading.style.display = 'none';
        if (content) content.style.display = 'block';
      });
  }

  function closeVideoDrawer() {
    const drawer = document.getElementById('video-drawer');
    const backdrop = document.getElementById('video-drawer-backdrop');
    if (drawer) drawer.classList.remove('open');
    if (backdrop) backdrop.classList.remove('open');
  }

  function populateVideoDrawer(raw, videoId) {
    const loading = document.getElementById('drawer-loading');
    const content = document.getElementById('drawer-content');
    if (loading) loading.style.display = 'none';
    if (content) content.style.display = 'block';

    const obj = raw.result || raw.video || raw.data || raw || {};

    const safeVal = (v) => (v !== undefined && v !== null && String(v).trim() !== '' ? String(v).trim() : '—');

    const id = safeVal(obj.videoId || obj.id || videoId);
    
    let title = safeVal(obj.scriptPreview || obj.title || obj.topic || obj.name);
    if (title.includes('\n')) {
      title = title.split('\n')[0].trim();
    }

    const scriptText = safeVal(obj.script || obj.scriptPreview);
    const editorBrief = safeVal(obj.editorBrief || obj.recordingNotes || obj.notes);
    const videoType = safeVal(obj.videoType || obj.contentType);
    const teacher = safeVal(obj.talent || obj.teacher || obj.instructor);
    const editor = safeVal(obj.editor || obj.assignedTo);
    const status = safeVal(obj.productionStatus || obj.status || obj.state);
    const sla = safeVal(obj.slaStatus || obj.sla);
    const qcChangeNotes = safeVal(obj.qcChangeNotes || obj.qcNotes);
    const blocker = safeVal(obj.blocker);
    const lastErrorAt = safeVal(obj.lastErrorAt);

    const mainFolder = obj.driveFolderUrl;
    const rawFolder = obj.rawFolderUrl || obj.rawFolder;
    const rawFile = obj.rawFileUrl || obj.rawFileLink;
    const finalFolder = obj.finalFolderUrl || obj.finalFolder;
    const finalFile = obj.finalFileUrl || obj.finalFileLink;
    if (window.__infinityBootstrap && Array.isArray(window.__infinityBootstrap.editorLoad)) {
      rememberEditorContacts(window.__infinityBootstrap.editorLoad);
    }

    document.getElementById('drawer-video-id').textContent = id;
    document.getElementById('drawer-title').textContent = title;
    document.getElementById('drawer-teacher').textContent = teacher;
    document.getElementById('drawer-editor').textContent = editor !== '—' ? editor : 'Unassigned';

    // Manager fields
    const scriptEl = document.getElementById('drawer-script-input');
    const editorBriefEl = document.getElementById('drawer-editor-brief-input');
    const videoTypeEl = document.getElementById('drawer-video-type');
    const qcNotesEl = document.getElementById('drawer-qc-notes');
    const accountEl = document.getElementById('drawer-account');
    const postUrlEl = document.getElementById('drawer-post-url');
    if (scriptEl) scriptEl.value = scriptText === '—' ? '' : scriptText;
    if (editorBriefEl) editorBriefEl.value = editorBrief === '—' ? '' : editorBrief;
    if (videoTypeEl) videoTypeEl.value = videoType === '—' ? 'Original Recording' : videoType;
    if (qcNotesEl) qcNotesEl.value = safeVal(obj.qcChangeNotes) === '—' ? '' : safeVal(obj.qcChangeNotes);
    if (accountEl) accountEl.value = safeVal(obj.account) === '—' ? '' : safeVal(obj.account);
    if (postUrlEl) postUrlEl.value = safeVal(obj.postUrl) === '—' ? '' : safeVal(obj.postUrl);
    renderOperationalAlert({ status, qcChangeNotes, blocker, lastErrorAt, sla });
    loadEditorOptions(editor).then(() => renderWhatsappHandoffs(obj));
    updateManagerActionState(obj);
    renderMissionProgress(obj);

    // Status Chip
    const statusChip = document.getElementById('drawer-status-chip');
    if (statusChip) {
      statusChip.textContent = status;
      const s = status.toLowerCase();
      statusChip.className = 'chip ' + (
        s.includes('approved') || s.includes('uploaded') || s.includes('done') ? 'chip-emerald' :
        s.includes('overdue') || s.includes('blocked') || s.includes('error') ? 'chip-red' :
        s.includes('qc') || s.includes('review') ? 'chip-purple' :
        s.includes('editing') || s.includes('in progress') ? 'chip-amber' :
        'chip-blue'
      );
    }

    // SLA chip
    const slaChip = document.getElementById('drawer-sla-chip');
    if (slaChip) {
      if (sla !== '—') {
        slaChip.style.display = 'inline-flex';
        const slaLower = sla.toLowerCase();
        slaChip.className = 'chip ' + (slaLower.includes('overdue') ? 'chip-red' : 'chip-default');
        slaChip.textContent = `SLA: ${sla}`;
      } else {
        slaChip.style.display = 'none';
      }
    }

    // External Links
    let hasAnyLink = false;
    const setLink = (rowId, linkId, url) => {
      const row = document.getElementById(rowId);
      const link = document.getElementById(linkId);
      if (url && String(url).startsWith('http')) {
        if (row) row.style.display = 'flex';
        if (link) link.href = String(url);
        hasAnyLink = true;
      } else {
        if (row) row.style.display = 'none';
      }
    };

    setLink('drawer-main-folder-row', 'drawer-main-folder-link', mainFolder);
    setLink('drawer-raw-folder-row', 'drawer-raw-folder-link', rawFolder);
    setLink('drawer-raw-file-row', 'drawer-raw-file-link', rawFile);
    setLink('drawer-final-folder-row', 'drawer-final-folder-link', finalFolder);
    setLink('drawer-final-file-row', 'drawer-final-file-link', finalFile);
    renderWhatsappHandoffs(obj);

    const noLinksEl = document.getElementById('drawer-no-links');
    if (noLinksEl) {
      noLinksEl.style.display = hasAnyLink ? 'none' : 'block';
    }

    // Timestamps
    const timelineContainer = document.getElementById('drawer-timeline-container');
    if (timelineContainer) {
      timelineContainer.innerHTML = '';
      const timestamps = [
        { label: 'Publish Date', val: obj.publishDate },
        { label: 'Assigned Date', val: obj.assignmentUpdatedAt },
        { label: 'Stage Updated', val: obj.stageUpdatedAt },
        { label: 'SLA Deadline', val: obj.dueAt }
      ].filter(t => t.val && String(t.val).trim() !== '');

      if (timestamps.length > 0) {
        timestamps.forEach(t => {
          const row = document.createElement('div');
          row.style.cssText = 'display: flex; justify-content: space-between; font-size: 0.75rem; padding: 0.25rem 0; border-bottom: 1px dashed var(--border-subtle);';
          row.innerHTML = `<span style="color: var(--text-muted); font-weight: 500;">${t.label}</span><span style="font-weight: 600; color: var(--text-main);">${safeVal(t.val)}</span>`;
          timelineContainer.appendChild(row);
        });
      } else {
        timelineContainer.innerHTML = '<div style="font-size: 0.8125rem; color: var(--text-subtle); padding: 0.25rem 0;">No timeline events recorded.</div>';
      }
    }
  }

  async function loadEditorOptions(selectedEditor) {
    const select = document.getElementById('drawer-editor-select');
    if (!select) return;
    if (editorOptionsLoaded && select.options.length > 1) {
      select.value = selectedEditor === '—' ? '' : selectedEditor;
      return;
    }
    try {
      const bootstrapList = window.__infinityBootstrap && window.__infinityBootstrap.editorLoad;
      let list = Array.isArray(bootstrapList) ? bootstrapList : null;
      if (!list) {
        const res = await fetch('/api/infinity', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify({action:'editor_load'}) });
        const data = await res.json().catch(() => ({}));
        list = data.result || data.editorLoad || data.editors || data.data || [];
      }
      select.innerHTML = '<option value="">Choose editor</option>';
      if (Array.isArray(list)) {
        rememberEditorContacts(list);
        list.filter(item => item && (item.active !== false)).forEach(item => {
          const name = String(item.editor || item.name || '').trim();
          if (!name) return;
          const phone = String(item.whatsapp || item.whatsappNumber || item.phone || item.mobile || '').replace(/\D/g, '');
          if (phone) editorPhoneByName.set(name, phone);
          const option = document.createElement('option');
          option.value = name;
          option.textContent = `${name} — ${Number(item.openLoad || 0)}/${Number(item.dailyCapacity || 0)} open`;
          select.appendChild(option);
        });
      }
      editorOptionsLoaded = true;
      select.value = selectedEditor === '—' ? '' : selectedEditor;
    } catch (_) {
      select.innerHTML = '<option value="">Editor list unavailable</option>';
    }
  }

  function buildWhatsAppUrl(phone, message) {
    const digits = String(phone || '').replace(/\D/g, '');
    return digits ? `https://wa.me/${digits}?text=${encodeURIComponent(message)}` : '';
  }

  function renderWhatsappHandoffs(obj) {
    const id = String(obj.videoId || activeSelectedVideoId || '').trim();
    const teacher = String(obj.teacher || obj.talent || '').trim();
    const editor = String(obj.editor || obj.assignedTo || '').trim();
    const rawFolder = obj.rawFolderUrl || obj.rawFolder || '';
    const rawFile = obj.rawFileUrl || obj.rawFileLink || '';
    const finalFolder = obj.finalFolderUrl || obj.finalFolder || '';
    const brief = String(obj.editorBrief || obj.recordingNotes || obj.notes || '').trim();
    const setHref = (rowId, linkId, href) => {
      const row = document.getElementById(rowId);
      const link = document.getElementById(linkId);
      if (row) row.style.display = href ? 'flex' : 'none';
      if (link && href) link.href = href;
    };
    const princeUrl = rawFolder ? buildWhatsAppUrl(PRINCE_WHATSAPP, `Hi Prince bhai,\n\n${id}${teacher ? ` (${teacher})` : ''} ka RAW folder ready hai.\n${rawFolder}\n\nPlease saari RAW videos isi folder mein upload kar dena.`) : '';
    setHref('drawer-prince-whatsapp-row', 'drawer-prince-whatsapp-link', princeUrl);

    const editorPhone = editorPhoneByName.get(editor) || '';
    const editorMessage = `Hi ${editor},\n\n${id} ki editing assigned hai.${teacher ? `\nTeacher: ${teacher}` : ''}${brief ? `\n\nEditor Brief:\n${brief}` : ''}${rawFile ? `\n\nRAW File: ${rawFile}` : rawFolder ? `\n\nRAW Folder: ${rawFolder}` : ''}${finalFolder ? `\nFINAL Folder: ${finalFolder}` : ''}`;
    const backendUrl = obj.editorWhatsAppUrl || obj.whatsappLink || obj.whatsapp || '';
    setHref('drawer-whatsapp-row', 'drawer-whatsapp-link', backendUrl || (editor && editorPhone ? buildWhatsAppUrl(editorPhone, editorMessage) : ''));
    const caption = document.getElementById('drawer-editor-whatsapp-caption');
    if (caption) caption.textContent = editor ? `${editor} · Editor Brief + RAW` : 'Assign editor first';
  }

  function rememberEditorContacts(list) {
    list.forEach(item => {
      if (!item) return;
      const name = String(item.editor || item.name || '').trim();
      const phone = String(item.whatsapp || item.whatsappNumber || item.phone || item.mobile || '').replace(/\D/g, '');
      if (name && phone) editorPhoneByName.set(name, phone);
    });
  }

  function renderMissionProgress(obj) {
    const status = String(obj.productionStatus || '').trim();
    const steps = [
      ['Script', Boolean(String(obj.script || '').trim())],
      ['Approve', Boolean(obj.scriptReady) || status !== 'Script Pending'],
      ['RAW folder', Boolean(obj.rawFolderUrl)],
      ['RAW ready', Boolean(obj.rawFileUrl)],
      ['Editor', Boolean(obj.editor)],
      ['FINAL', Boolean(obj.finalFileUrl)],
      ['QC', ['Approved', 'Uploaded'].includes(status)],
      ['Uploaded', Boolean(obj.posted) || status === 'Uploaded']
    ];
    let completed = 0;
    steps.forEach(([, done], index) => { if (done && index === completed) completed++; });
    const current = Math.min(completed, steps.length - 1);
    const progress = Math.round((completed / steps.length) * 100);
    const level = document.getElementById('drawer-mission-level');
    const next = document.getElementById('drawer-mission-next');
    const bar = document.getElementById('drawer-mission-progress');
    const list = document.getElementById('drawer-mission-steps');
    if (level) level.textContent = completed === steps.length ? 'MISSION COMPLETE · 8/8' : `LEVEL ${completed + 1} OF ${steps.length}`;
    if (next) next.textContent = completed === steps.length ? 'Video shipped 🎉' : `Next: ${steps[completed][0]}`;
    if (bar) bar.style.width = `${progress}%`;
    if (list) list.innerHTML = steps.map(([label, done], index) => `<div class="mission-step ${done ? 'done' : index === current ? 'current' : ''}"><b>${done ? '✓' : index + 1}</b><span title="${label}">${label}</span></div>`).join('');
  }

  function updateManagerActionState(obj) {
    const status = String(obj.productionStatus || '').trim();
    const hasRaw = Boolean(obj.rawFileUrl);
    const posted = Boolean(obj.posted) || status === 'Uploaded';
    const setDisabled = (id, disabled, title) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.disabled = Boolean(disabled);
      el.title = disabled ? title : '';
    };
    setDisabled('save-script-btn', hasRaw || posted, hasRaw ? 'Script is locked after RAW detection.' : 'Uploaded history is locked.');
    setDisabled('approve-script-btn', hasRaw || posted || !String(obj.script || '').trim(), 'Approval requires an editable non-empty script before RAW detection.');
    setDisabled('assign-editor-btn', posted, 'Uploaded history is locked.');
    setDisabled('detect-raw-btn', !obj.rawFolderUrl || posted, 'Approve the script to create the RAW folder first.');
    setDisabled('detect-final-btn', !['Editing','Changes'].includes(status), 'FINAL detection is available only during Editing or Changes.');
    setDisabled('qc-changes-btn', status !== 'QC Pending', 'QC actions require QC Pending status.');
    setDisabled('qc-approve-btn', status !== 'QC Pending', 'QC actions require QC Pending status.');
    setDisabled('mark-uploaded-btn', status !== 'Approved', 'The video must be QC Approved first.');
    const qcApproveButton = document.getElementById('qc-approve-btn');
    const qcChangesButton = document.getElementById('qc-changes-btn');
    if (qcApproveButton) qcApproveButton.textContent = ['Approved', 'Uploaded'].includes(status) ? 'QC Approved ✓' : 'Approve QC ✓';
    if (qcChangesButton) qcChangesButton.textContent = status === 'Changes' ? 'Changes Requested ✓' : 'Request Changes';
  }

  function renderOperationalAlert({ status, qcChangeNotes, blocker, lastErrorAt, sla }) {
    const panel = document.getElementById('drawer-operational-alert');
    const title = document.getElementById('drawer-operational-alert-title');
    const badge = document.getElementById('drawer-operational-alert-badge');
    const text = document.getElementById('drawer-operational-alert-text');
    const help = document.getElementById('drawer-operational-alert-help');
    if (!panel) return;

    const isChanges = /change|revision|rework/i.test(`${status}`);
    const isOverdue = /overdue|breach/i.test(`${sla}`);
    const instruction = qcChangeNotes !== '—' ? qcChangeNotes : blocker !== '—' ? blocker : '';
    const hasIssue = isChanges || Boolean(instruction) || lastErrorAt !== '—' || isOverdue;
    panel.style.display = hasIssue ? 'block' : 'none';
    if (!hasIssue) return;

    if (title) title.textContent = isChanges ? 'Changes required' : blocker !== '—' ? 'Workflow blocked' : isOverdue ? 'SLA overdue' : 'Operational issue';
    if (badge) badge.textContent = isChanges ? 'Changes' : blocker !== '—' ? 'Blocked' : isOverdue ? 'Overdue' : 'Error';
    if (text) text.textContent = instruction || (isOverdue ? `This video is ${sla}. Open the row and move the pending step forward.` : `The last workflow error was recorded at ${lastErrorAt}.`);
    if (help) help.textContent = isChanges
      ? 'Editor: follow this instruction, upload a new file in the FINAL folder, then manager runs Detect FINAL for a fresh QC revision.'
      : 'Resolve the message above in the Sheet or this drawer, then press Refresh to confirm the workflow recovered.';
  }

  function managerErrorMessage(data, fallback) {
    if (data && data.error && typeof data.error === 'object' && data.error.message) return data.error.message;
    if (data && typeof data.error === 'string') return data.error;
    return fallback;
  }

  function startManagerActionProgress(title, estimate = 'Usually completes in 5–20 seconds. Keep this screen open.') {
    const panel = document.getElementById('manager-action-progress');
    const titleEl = document.getElementById('manager-action-progress-title');
    const timeEl = document.getElementById('manager-action-progress-time');
    const noteEl = document.getElementById('manager-action-progress-note');
    const startedAt = Date.now();
    if (panel) panel.style.display = 'block';
    if (titleEl) titleEl.textContent = title;
    if (noteEl) noteEl.textContent = estimate;
    if (timeEl) timeEl.textContent = '0s elapsed';
    if (managerActionTimer) clearInterval(managerActionTimer);
    managerActionTimer = setInterval(() => {
      const seconds = Math.max(0, Math.floor((Date.now() - startedAt) / 1000));
      if (timeEl) timeEl.textContent = `${seconds}s elapsed`;
      if (noteEl && seconds >= 20) noteEl.textContent = 'Apps Script is taking longer than usual. The request is still running safely.';
    }, 1000);
  }

  function finishManagerActionProgress(message, succeeded) {
    if (managerActionTimer) clearInterval(managerActionTimer);
    managerActionTimer = null;
    const panel = document.getElementById('manager-action-progress');
    const titleEl = document.getElementById('manager-action-progress-title');
    const noteEl = document.getElementById('manager-action-progress-note');
    if (panel) panel.classList.toggle('is-success', Boolean(succeeded));
    if (panel) panel.classList.toggle('is-error', !succeeded);
    if (titleEl) titleEl.textContent = succeeded ? 'Completed ✓' : 'Action needs attention';
    if (noteEl) noteEl.textContent = message;
  }

  async function runManagerAction(action, payload, successMessage, options = {}) {
    if (!activeSelectedVideoId || isManagerActionRunning) return null;
    isManagerActionRunning = true;
    const actionButton = options.buttonId ? document.getElementById(options.buttonId) : null;
    const originalButtonText = actionButton?.textContent || '';
    if (actionButton) {
      actionButton.disabled = true;
      actionButton.setAttribute('aria-busy', 'true');
      actionButton.textContent = options.pendingLabel || 'Processing…';
    }
    startManagerActionProgress(options.progressTitle || 'Processing action…', options.estimateText);
    const box = document.getElementById('manager-action-message');
    if (box) {
      box.style.display = 'block'; box.style.background = 'var(--bg-subtle)'; box.style.color = 'var(--text-main)'; box.textContent = 'Working...';
    }
    try {
      const requestId = crypto.randomUUID ? crypto.randomUUID() : String(Date.now());
      let data = {};
      let res = null;
      for (let attempt = 0; attempt < 3; attempt++) {
        if (attempt > 0 && box) box.textContent = `Backend busy — retrying (${attempt + 1}/3)…`;
        res = await fetch('/api/infinity', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify({action, videoId:activeSelectedVideoId, requestId, ...payload}) });
        data = await res.json().catch(() => ({}));
        const message = managerErrorMessage(data, 'Manager action failed');
        const code = String(data?.error?.code || data?.code || '').toUpperCase();
        const retryable = code === 'SYSTEM_BUSY' || /another infinity operation|retry shortly|system busy/i.test(message);
        if (res.ok && data.ok !== false) break;
        if (!retryable || attempt === 2) throw new Error(message);
        await new Promise(resolve => setTimeout(resolve, 650 * (attempt + 1)));
      }
      if (!res || !res.ok || data.ok === false) throw new Error(managerErrorMessage(data, 'Manager action failed'));
      videoDetailCache.delete(activeSelectedVideoId);
      if (box) { box.style.background = '#f0fdf4'; box.style.color = '#15803d'; box.textContent = successMessage; }
      if (actionButton) actionButton.textContent = options.successLabel || 'Completed ✓';
      finishManagerActionProgress(successMessage, true);
      showToast(successMessage, 'success');
      await openVideoDrawer(activeSelectedVideoId);
      if (typeof window.__refreshOperationsData === 'function') window.__refreshOperationsData();
      return data;
    } catch (error) {
      if (box) { box.style.background = '#fff1f2'; box.style.color = '#be123c'; box.textContent = error.message || 'Manager action failed'; }
      if (actionButton) {
        actionButton.disabled = false;
        actionButton.textContent = originalButtonText;
      }
      finishManagerActionProgress(error.message || 'Manager action failed', false);
      showToast(error.message || 'Manager action failed', 'error');
      return null;
    } finally {
      if (actionButton) actionButton.removeAttribute('aria-busy');
      isManagerActionRunning = false;
    }
  }

  async function runQueuedManagerAction(queuedAction, payload, successMessage, options = {}) {
    if (!activeSelectedVideoId || isManagerActionRunning) return null;
    isManagerActionRunning = true;
    const actionButton = options.buttonId ? document.getElementById(options.buttonId) : null;
    const originalButtonText = actionButton?.textContent || '';
    if (actionButton) { actionButton.disabled = true; actionButton.setAttribute('aria-busy', 'true'); actionButton.textContent = 'Queued…'; }
    startManagerActionProgress('Action saved in reliable queue…', 'The backend retries automatically. You may safely close this screen.');
    const box = document.getElementById('manager-action-message');
    try {
      const requestId = crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${queuedAction}`;
      const queued = await fetch('/api/infinity', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ action:'queue_action', queuedAction, videoId:activeSelectedVideoId, requestId, payload }) });
      const queuedData = await queued.json().catch(() => ({}));
      if (!queued.ok || queuedData.ok === false || !queuedData.jobId) throw new Error(managerErrorMessage(queuedData, 'Could not save action in queue.'));
      if (box) { box.style.display='block'; box.style.background='#eff6ff'; box.style.color='#1d4ed8'; box.textContent='Queued safely. Backend processing started…'; }
      const jobId = queuedData.jobId;
      const deadline = Date.now() + 90000;
      while (Date.now() < deadline) {
        await new Promise(resolve => setTimeout(resolve, 3000));
        const statusRes = await fetch('/api/infinity', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ action:'job_status', jobId, refresh:true }) });
        const job = await statusRes.json().catch(() => ({}));
        if (!statusRes.ok || job.ok === false) continue;
        const attempt = Number(job.attemptCount || 0), max = Number(job.maxAttempts || 5);
        if (actionButton) actionButton.textContent = job.status === 'Processing' ? `Processing ${attempt}/${max}…` : `Queued ${attempt}/${max}…`;
        if (box) box.textContent = `${job.status} · attempt ${attempt}/${max}${job.error ? ` · ${job.error}` : ''}`;
        if (job.status === 'Completed') {
          videoDetailCache.delete(activeSelectedVideoId);
          if (actionButton) actionButton.textContent = options.successLabel || 'Completed ✓';
          if (box) { box.style.background='#f0fdf4'; box.style.color='#15803d'; box.textContent=successMessage; }
          finishManagerActionProgress(successMessage, true); showToast(successMessage, 'success');
          await openVideoDrawer(activeSelectedVideoId);
          if (typeof window.__refreshOperationsData === 'function') window.__refreshOperationsData();
          return job;
        }
        if (job.status === 'Failed') throw new Error(job.error || 'Backend could not complete this action after 5 attempts.');
      }
      const pendingMessage = 'Action is saved in the queue. Backend will keep retrying; refresh later to see the final state.';
      if (box) box.textContent = pendingMessage;
      finishManagerActionProgress(pendingMessage, true); showToast('Action queued safely', 'success');
      return queuedData;
    } catch (error) {
      if (actionButton) { actionButton.disabled = false; actionButton.textContent = originalButtonText; }
      if (box) { box.style.display='block'; box.style.background='#fff1f2'; box.style.color='#be123c'; box.textContent=error.message || 'Queue action failed'; }
      finishManagerActionProgress(error.message || 'Queue action failed', false); showToast(error.message || 'Queue action failed', 'error');
      return null;
    } finally {
      if (actionButton) actionButton.removeAttribute('aria-busy');
      isManagerActionRunning = false;
    }
  }

  function saveManagerScript() {
    const script = document.getElementById('drawer-script-input')?.value.trim() || '';
    const editorBrief = document.getElementById('drawer-editor-brief-input')?.value.trim() || '';
    const videoType = document.getElementById('drawer-video-type')?.value || 'Original Recording';
    if (videoType === 'Original Recording' && !script) { showToast('Recording Script is required', 'error'); return; }
    if (!editorBrief) { showToast('Editor Brief is required', 'error'); return; }
    return runManagerAction('update_script', { script: script || editorBrief, recordingScript: script, editorBrief, videoType }, 'Content saved. Approval is required before production.');
  }

  function approveManagerScript() {
    const script = document.getElementById('drawer-script-input')?.value.trim() || '';
    const editorBrief = document.getElementById('drawer-editor-brief-input')?.value.trim() || '';
    const videoType = document.getElementById('drawer-video-type')?.value || 'Original Recording';
    if (videoType === 'Original Recording' && !script) { showToast('Recording Script is required', 'error'); return; }
    if (!editorBrief) { showToast('Editor Brief is required', 'error'); return; }
    return runQueuedManagerAction('approve_script', { script: script || editorBrief, recordingScript: script, editorBrief, videoType }, 'Content approved and Drive folders prepared.', {
      buttonId: 'approve-script-btn',
      pendingLabel: 'Preparing folders…',
      successLabel: 'Content Approved ✓',
      progressTitle: 'Approving content and preparing Drive folders…',
      estimateText: 'Usually completes in 8–25 seconds because Google Drive folders are checked and prepared.'
    });
  }

  function assignManagerEditor() {
    const editor = document.getElementById('drawer-editor-select')?.value || '';
    if (!editor) { showToast('Choose an editor', 'error'); return; }
    return runManagerAction('assign_editor', { editor }, 'Editor assignment updated.');
  }

  function detectManagerFinal() {
    return runManagerAction('detect_final', {}, 'FINAL detection completed.');
  }

  function submitManagerQcApprove() {
    const notes = document.getElementById('drawer-qc-notes')?.value.trim() || '';
    return runQueuedManagerAction('qc_approve', { notes }, 'QC approved. Video is ready for publishing.', {
      buttonId: 'qc-approve-btn',
      pendingLabel: 'Approving QC…',
      successLabel: 'QC Approved ✓',
      progressTitle: 'Saving QC approval…',
      estimateText: 'Usually completes in 5–20 seconds. The button stays locked to prevent duplicate approvals.'
    });
  }

  function submitManagerQcChanges() {
    const notes = document.getElementById('drawer-qc-notes')?.value.trim() || '';
    if (!notes) { showToast('Change notes are required', 'error'); return; }
    return runManagerAction('qc_changes', { notes }, 'Changes requested and sent back to editing.', {
      buttonId: 'qc-changes-btn',
      pendingLabel: 'Sending changes…',
      successLabel: 'Changes Requested ✓',
      progressTitle: 'Saving QC changes…'
    });
  }

  function markManagerUploaded() {
    const account = document.getElementById('drawer-account')?.value.trim() || '';
    const postUrl = document.getElementById('drawer-post-url')?.value.trim() || '';
    if (!account || !postUrl) { showToast('Account and Post URL are required', 'error'); return; }
    return runManagerAction('mark_uploaded', { account, postUrl }, 'Upload confirmed and history recorded.');
  }

  function openDetectRawModal() {
    if (!activeSelectedVideoId || activeSelectedVideoId === '—') {
      showToast('No valid video selected', 'error');
      return;
    }
    const modal = document.getElementById('detect-raw-modal');
    const modalVideoId = document.getElementById('modal-video-id');
    const statusBox = document.getElementById('modal-action-status');
    const confirmBtn = document.getElementById('modal-confirm-btn');
    const confirmText = document.getElementById('modal-confirm-text');

    if (modalVideoId) modalVideoId.textContent = activeSelectedVideoId;
    if (statusBox) statusBox.style.display = 'none';
    if (confirmBtn) confirmBtn.disabled = false;
    if (confirmText) confirmText.textContent = 'Confirm & Run';
    if (modal) modal.classList.add('open');
  }

  function closeDetectRawModal() {
    if (isDetectRawRunning) return; // Prevent closing while running
    const modal = document.getElementById('detect-raw-modal');
    if (modal) modal.classList.remove('open');
  }

  async function executeDetectRaw() {
    if (!activeSelectedVideoId || isDetectRawRunning) return;

    isDetectRawRunning = true;
    const confirmBtn = document.getElementById('modal-confirm-btn');
    const cancelBtn = document.getElementById('modal-cancel-btn');
    const confirmText = document.getElementById('modal-confirm-text');
    const statusBox = document.getElementById('modal-action-status');

    if (confirmBtn) confirmBtn.disabled = true;
    if (cancelBtn) cancelBtn.disabled = true;
    if (confirmText) confirmText.textContent = 'Scanning Drive...';

    if (statusBox) {
      statusBox.style.display = 'block';
      statusBox.style.background = 'var(--bg-subtle)';
      statusBox.style.color = 'var(--text-main)';
      statusBox.textContent = 'Contacting Apps Script engine to scan RAW folder...';
    }

    try {
      const res = await fetch('/api/infinity', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'detect_raw',
          videoId: activeSelectedVideoId
        })
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok || data.ok === false) {
        throw new Error(data.error || 'Failed to detect RAW');
      }

      if (statusBox) {
        statusBox.style.background = '#f0fdf4';
        statusBox.style.color = '#15803d';
        statusBox.textContent = data.message || 'RAW scan completed successfully.';
      }

      showToast('RAW Detection completed successfully!', 'success');

      // Refresh drawer and page data
      videoDetailCache.delete(activeSelectedVideoId);
      isDetectRawRunning = false;
      closeDetectRawModal();
      openVideoDrawer(activeSelectedVideoId);
      if (typeof window.__refreshOperationsData === 'function') window.__refreshOperationsData();

    } catch (err) {
      isDetectRawRunning = false;
      if (statusBox) {
        statusBox.style.background = '#fff1f2';
        statusBox.style.color = '#be123c';
        statusBox.textContent = err.message || 'Error occurred while detecting RAW.';
      }
      showToast(err.message || 'Detection failed', 'error');
    } finally {
      if (!isDetectRawRunning) {
        if (confirmBtn) confirmBtn.disabled = false;
        if (cancelBtn) cancelBtn.disabled = false;
        if (confirmText) confirmText.textContent = 'Confirm & Run';
      }
    }
  }

  // Expose to window for external row clicks
  window.openVideoDrawer = openVideoDrawer;
  window.closeVideoDrawer = closeVideoDrawer;
  window.openDetectRawModal = openDetectRawModal;
  window.closeDetectRawModal = closeDetectRawModal;
  window.executeDetectRaw = executeDetectRaw;
  window.saveManagerScript = saveManagerScript;
  window.approveManagerScript = approveManagerScript;
  window.assignManagerEditor = assignManagerEditor;
  window.detectManagerFinal = detectManagerFinal;
  window.submitManagerQcApprove = submitManagerQcApprove;
  window.submitManagerQcChanges = submitManagerQcChanges;
  window.markManagerUploaded = markManagerUploaded;
</script>
