---
import Layout from '../layouts/Layout.astro';
import VideoDetailDrawer from '../components/VideoDetailDrawer.astro';
---

<Layout title="Videos Management" activeTab="videos">
  <!-- Controls Bar: Search & Filters -->
  <div class="card" style="padding: 1rem 1.25rem; margin-bottom: 1.25rem;">
    <div style="display: flex; flex-wrap: wrap; gap: 0.875rem; align-items: center; justify-content: space-between;">
      <!-- Search Input -->
      <div style="position: relative; flex: 1; min-width: 240px; max-width: 400px;">
        <input
          id="video-search-input"
          type="text"
          placeholder="Search by title, ID, teacher, editor..."
          oninput="handleSearchChange()"
          style="width: 100%; padding: 0.5rem 0.75rem 0.5rem 2.25rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff;"
        />
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </div>

      <!-- Filters Group -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
        <!-- Status Filter -->
        <select
          id="status-filter-select"
          onchange="handleFilterChange()"
          style="padding: 0.5rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff; color: var(--text-main); font-weight: 500;"
        >
          <option value="">All Statuses</option>
        </select>

        <!-- Editor Filter -->
        <select
          id="editor-filter-select"
          onchange="handleFilterChange()"
          style="padding: 0.5rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff; color: var(--text-main); font-weight: 500;"
        >
          <option value="">All Editors</option>
        </select>

        <button class="btn btn-secondary btn-sm" onclick="resetFilters()" style="padding: 0.5rem 0.75rem;">
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div id="videos-error" class="error-state" style="display: none; margin-bottom: 1.5rem;">
    <div style="font-weight: 700; font-size: 0.95rem;">Unable to load video records</div>
    <p id="videos-error-text" style="font-size: 0.8125rem; margin-top: 0.25rem;">Connection failed.</p>
    <button class="btn btn-primary btn-sm" onclick="loadVideosList()" style="margin-top: 0.5rem;">
      Retry
    </button>
  </div>

  <!-- Loading Skeletons -->
  <div id="videos-loading" class="card" style="padding: 1.5rem; display: block;">
    <div class="skeleton skeleton-title"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
  </div>

  <!-- Videos Table Container -->
  <div id="videos-table-container" class="card" style="display: none;">
    <div class="table-container">
      <table class="compact-table">
        <thead>
          <tr>
            <th style="width: 110px;">Video ID</th>
            <th>Title / Topic</th>
            <th>Teacher / Talent</th>
            <th>Editor</th>
            <th>Status</th>
            <th>SLA / Due</th>
            <th>RAW / FINAL</th>
            <th style="width: 80px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody id="videos-tbody">
          <!-- Populated dynamically -->
        </tbody>
      </table>
    </div>

    <!-- Empty State for Table -->
    <div id="videos-empty" class="empty-state" style="display: none;">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);">
        <polygon points="23 7 16 12 23 17 23 7" />
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
      </svg>
      <p style="font-size: 0.875rem; font-weight: 600;">No videos match the current filters.</p>
    </div>

    <!-- Pagination & Summary Footer -->
    <div style="padding: 0.875rem 1.25rem; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8125rem; color: var(--text-muted);">
      <div>
        Showing <span id="page-start-idx" style="font-weight: 700; color: var(--text-main);">0</span> to <span id="page-end-idx" style="font-weight: 700; color: var(--text-main);">0</span> of <span id="total-videos-count" style="font-weight: 700; color: var(--text-main);">0</span> videos
      </div>
      <div style="display: flex; gap: 0.375rem;">
        <button id="prev-page-btn" class="btn btn-secondary btn-sm" onclick="changePage(-1)" disabled>Previous</button>
        <button id="next-page-btn" class="btn btn-secondary btn-sm" onclick="changePage(1)" disabled>Next</button>
      </div>
    </div>
  </div>

  <!-- Detail Drawer Component -->
  <VideoDetailDrawer />

  <script is:inline>
    let allVideos = [];
    let filteredVideos = [];
    let currentPage = 1;
    const PAGE_SIZE = 15;

    async function loadVideosList() {
      const loading = document.getElementById('videos-loading');
      const tableContainer = document.getElementById('videos-table-container');
      const errorBox = document.getElementById('videos-error');
      const errorText = document.getElementById('videos-error-text');
      const lastUpdatedEl = document.getElementById('last-updated-text');

      if (loading) loading.style.display = 'block';
      if (tableContainer) tableContainer.style.display = 'none';
      if (errorBox) errorBox.style.display = 'none';

      try {
        const res = await fetch('/api/infinity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'videos' })
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.ok === false) {
          throw new Error(data.error || 'Failed to load videos list');
        }

        const rawList = data.videos || data.data || data.result || data.items || (Array.isArray(data) ? data : []);
        normalizeAndStoreVideos(rawList);

        if (lastUpdatedEl) {
          const d = new Date();
          lastUpdatedEl.textContent = `Updated ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        }

        if (loading) loading.style.display = 'none';
        if (tableContainer) tableContainer.style.display = 'block';
      } catch (err) {
        if (loading) loading.style.display = 'none';
        if (errorBox) {
          if (errorText) errorText.textContent = err.message || 'Failed to fetch videos from server.';
          errorBox.style.display = 'block';
        }
      }
    }

    function safeVal(val) {
      if (val === null || val === undefined) return '—';
      const str = String(val).trim();
      return str === '' ? '—' : str;
    }

    function normalizeAndStoreVideos(rawList) {
      if (!Array.isArray(rawList)) {
        allVideos = [];
        filteredVideos = [];
        renderTablePage();
        return;
      }

      allVideos = rawList.map(item => {
        if (!item || typeof item !== 'object') {
          return { id: '—', title: '—', teacher: '—', editor: '—', status: '—', sla: '—', rawAvailable: false, finalAvailable: false };
        }

        const id = safeVal(item.id || item.videoId || item.video_id || item.code);
        const title = safeVal(item.title || item.topic || item.name || item.subject);
        const teacher = safeVal(item.teacher || item.talent || item.instructor || item.faculty);
        const editor = safeVal(item.editor || item.assignedTo || item.editorName);
        const status = safeVal(item.status || item.state || item.currentStatus);
        const sla = safeVal(item.sla || item.slaState || item.dueDate || item.deadline);

        const hasRaw = Boolean(item.rawAvailable || item.hasRaw || item.rawFolder || item.rawLink || item.rawUrl);
        const hasFinal = Boolean(item.finalAvailable || item.hasFinal || item.finalFolder || item.finalLink || item.finalUrl);

        return { id, title, teacher, editor, status, sla, rawAvailable: hasRaw, finalAvailable: hasFinal, rawRecord: item };
      });

      populateFilterOptions();
      applyFilters();
    }

    function populateFilterOptions() {
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      const statuses = new Set();
      const editors = new Set();

      allVideos.forEach(v => {
        if (v.status && v.status !== '—') statuses.add(v.status);
        if (v.editor && v.editor !== '—') editors.add(v.editor);
      });

      if (statusSelect) {
        const curr = statusSelect.value;
        statusSelect.innerHTML = '<option value="">All Statuses</option>';
        Array.from(statuses).sort().forEach(s => {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = s;
          statusSelect.appendChild(opt);
        });
        statusSelect.value = curr;
      }

      if (editorSelect) {
        const curr = editorSelect.value;
        editorSelect.innerHTML = '<option value="">All Editors</option>';
        Array.from(editors).sort().forEach(e => {
          const opt = document.createElement('option');
          opt.value = e;
          opt.textContent = e;
          editorSelect.appendChild(opt);
        });
        editorSelect.value = curr;
      }
    }

    function handleSearchChange() {
      currentPage = 1;
      applyFilters();
    }

    function handleFilterChange() {
      currentPage = 1;
      applyFilters();
    }

    function resetFilters() {
      const searchInput = document.getElementById('video-search-input');
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      if (searchInput) searchInput.value = '';
      if (statusSelect) statusSelect.value = '';
      if (editorSelect) editorSelect.value = '';

      currentPage = 1;
      applyFilters();
    }

    function applyFilters() {
      const searchInput = document.getElementById('video-search-input');
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
      const statusFilter = statusSelect ? statusSelect.value : '';
      const editorFilter = editorSelect ? editorSelect.value : '';

      filteredVideos = allVideos.filter(v => {
        if (statusFilter && v.status !== statusFilter) return false;
        if (editorFilter && v.editor !== editorFilter) return false;

        if (query) {
          const matchId = v.id.toLowerCase().includes(query);
          const matchTitle = v.title.toLowerCase().includes(query);
          const matchTeacher = v.teacher.toLowerCase().includes(query);
          const matchEditor = v.editor.toLowerCase().includes(query);
          if (!matchId && !matchTitle && !matchTeacher && !matchEditor) return false;
        }

        return true;
      });

      renderTablePage();
    }

    function changePage(delta) {
      const maxPage = Math.ceil(filteredVideos.length / PAGE_SIZE) || 1;
      currentPage = Math.max(1, Math.min(maxPage, currentPage + delta));
      renderTablePage();
    }

    function renderTablePage() {
      const tbody = document.getElementById('videos-tbody');
      const emptyBox = document.getElementById('videos-empty');
      const startEl = document.getElementById('page-start-idx');
      const endEl = document.getElementById('page-end-idx');
      const countEl = document.getElementById('total-videos-count');
      const prevBtn = document.getElementById('prev-page-btn');
      const nextBtn = document.getElementById('next-page-btn');

      const total = filteredVideos.length;
      const start = total === 0 ? 0 : (currentPage - 1) * PAGE_SIZE;
      const end = Math.min(start + PAGE_SIZE, total);
      const pageItems = filteredVideos.slice(start, end);

      if (startEl) startEl.textContent = total === 0 ? '0' : String(start + 1);
      if (endEl) endEl.textContent = String(end);
      if (countEl) countEl.textContent = String(total);

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = end >= total;

      if (!tbody) return;
      tbody.innerHTML = '';

      if (pageItems.length === 0) {
        if (emptyBox) emptyBox.style.display = 'flex';
        return;
      }

      if (emptyBox) emptyBox.style.display = 'none';

      pageItems.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'clickable-row';
        tr.onclick = (e) => {
          // If clicked action button or link directly, let button handle
          if (e.target && (e.target.tagName === 'BUTTON' || e.target.closest('button'))) return;
          if (item.id !== '—' && typeof window.openVideoDrawer === 'function') {
            window.openVideoDrawer(item.id);
          }
        };

        const s = item.status.toLowerCase();
        const chipClass = 
          s.includes('approved') || s.includes('uploaded') || s.includes('done') ? 'chip-emerald' :
          s.includes('overdue') || s.includes('blocked') || s.includes('error') ? 'chip-red' :
          s.includes('qc') || s.includes('review') ? 'chip-purple' :
          s.includes('change') || s.includes('revision') ? 'chip-rose' :
          s.includes('editing') || s.includes('in progress') ? 'chip-amber' :
          'chip-blue';

        tr.innerHTML = `
          <td><span class="font-mono" style="font-size: 0.75rem; font-weight: 700; color: var(--brand-700);">${item.id}</span></td>
          <td><div style="font-weight: 600; color: var(--text-main); line-height: 1.3;">${item.title}</div></td>
          <td><div style="color: var(--text-muted);">${item.teacher}</div></td>
          <td><div style="color: var(--text-muted); font-weight: 500;">${item.editor}</div></td>
          <td><span class="chip ${chipClass}">${item.status}</span></td>
          <td><span style="font-size: 0.75rem; color: var(--text-muted);">${item.sla}</span></td>
          <td>
            <div style="display: flex; gap: 0.25rem;">
              <span class="chip ${item.rawAvailable ? 'chip-emerald' : 'chip-default'}" style="font-size: 0.6875rem; padding: 0.1rem 0.35rem;">RAW</span>
              <span class="chip ${item.finalAvailable ? 'chip-emerald' : 'chip-default'}" style="font-size: 0.6875rem; padding: 0.1rem 0.35rem;">FINAL</span>
            </div>
          </td>
          <td style="text-align: right;">
            <button class="btn btn-secondary btn-sm" onclick="window.openVideoDrawer('${item.id}')" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">
              Details
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });
    }

    // Set refresh hook
    window.__refreshOperationsData = loadVideosList;

    // Initial load
    document.addEventListener('DOMContentLoaded', () => {
      loadVideosList();
    });
  </script>
</Layout>
