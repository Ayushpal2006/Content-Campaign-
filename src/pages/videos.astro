---
import Layout from '../layouts/Layout.astro';
import VideoDetailDrawer from '../components/VideoDetailDrawer.astro';
---

<Layout title="Videos Management" activeTab="videos">
  <!-- Controls Bar: Search & Filters -->
  <div class="card" style="padding: 0.875rem 1.25rem; margin-bottom: 1.25rem;">
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: space-between;">
      <!-- Search Input -->
      <div style="position: relative; flex: 1; min-width: 240px; max-width: 380px;">
        <input
          id="video-search-input"
          type="text"
          placeholder="Search by title, ID, teacher, editor..."
          oninput="handleSearchChange()"
          style="width: 100%; padding: 0.45rem 0.75rem 0.45rem 2.25rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff;"
        />
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
      </div>

      <!-- Filters Group -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.625rem; align-items: center;">
        <button class="btn btn-primary btn-sm" onclick="openCreateVideoModal()" style="padding: 0.45rem 0.75rem;">
          + New Script
        </button>
        <!-- Status Filter -->
        <select
          id="status-filter-select"
          onchange="handleFilterChange()"
          style="padding: 0.45rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff; color: var(--text-main); font-weight: 500;"
        >
          <option value="">All Statuses</option>
        </select>

        <!-- Editor Filter -->
        <select
          id="editor-filter-select"
          onchange="handleFilterChange()"
          style="padding: 0.45rem 0.75rem; border: 1px solid var(--border-strong); border-radius: var(--radius-md); font-size: 0.8125rem; background: #fff; color: var(--text-main); font-weight: 500;"
        >
          <option value="">All Editors</option>
        </select>

        <button class="btn btn-secondary btn-sm" onclick="resetFilters()" style="padding: 0.45rem 0.75rem;">
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Manager: Create video/script -->
  <div id="create-video-modal" class="modal-backdrop">
    <div class="modal-card" style="width: min(620px, calc(100vw - 2rem)); max-width: 620px;">
      <div>
        <h3 style="font-size: 1rem; font-weight: 750;">Create Content Job</h3>
        <p style="font-size: 0.8125rem; color: var(--text-muted); margin-top: 0.2rem;">Recording Script is for the teacher. Editor Brief is what the assigned editor receives.</p>
      </div>
      <form id="create-video-form" style="display: grid; gap: 0.75rem;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <label class="manager-field">Video ID<input id="create-video-id" required placeholder="27/08-0026" /></label>
          <label class="manager-field">Publish Date<input id="create-publish-date" type="date" required /></label>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem;">
          <label class="manager-field">Teacher<input id="create-teacher" required placeholder="Teacher name" /></label>
          <label class="manager-field">Priority
            <select id="create-priority">
              <option>P2 - Normal</option><option>P0 - Critical</option><option>P1 - High</option><option>P3 - Low</option>
            </select>
          </label>
        </div>
        <label class="manager-field">Video Type
          <select id="create-video-type" onchange="handleCreateVideoTypeChange()">
            <option value="Original Recording">Original Recording</option>
            <option value="Repurpose">Repurpose</option>
            <option value="Existing RAW">Existing RAW</option>
          </select>
        </label>
        <label id="create-recording-script-field" class="manager-field">Recording Script
          <textarea id="create-recording-script" rows="6" placeholder="Exactly what the teacher should say, including hook and delivery cues..."></textarea>
        </label>
        <label class="manager-field">Editor Brief
          <textarea id="create-editor-brief" rows="6" required placeholder="Source/timestamps, first frame, cuts, subtitles, SFX, duration and caption..."></textarea>
        </label>
        <div id="create-video-error" class="error-state" style="display:none;"></div>
        <div style="display:flex; justify-content:flex-end; gap:0.5rem;">
          <button type="button" class="btn btn-secondary" onclick="closeCreateVideoModal()">Cancel</button>
          <button id="create-video-submit" type="submit" class="btn btn-primary">Create Draft</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Error State -->
  <div id="videos-error" class="error-state" style="display: none; margin-bottom: 1.25rem;">
    <div style="font-weight: 700; font-size: 0.95rem;">Unable to load video records</div>
    <p id="videos-error-text" style="font-size: 0.8125rem; margin-top: 0.25rem;">Connection failed.</p>
    <button class="btn btn-primary btn-sm" onclick="loadVideosList()" style="margin-top: 0.5rem;">
      Retry
    </button>
  </div>

  <!-- Loading Skeletons -->
  <div id="videos-loading" class="card" style="padding: 1.25rem; display: block;">
    <div class="skeleton skeleton-title"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
    <div class="skeleton skeleton-text"></div>
  </div>

  <!-- Videos Table Container -->
  <div id="videos-table-container" class="card" style="display: none;">
    <div class="table-container">
      <table class="compact-table">
        <thead>
          <tr>
            <th style="width: 110px;">Video ID</th>
            <th style="min-width: 220px;">Title / Script Hook</th>
            <th style="width: 120px;">Teacher</th>
            <th style="width: 130px;">Editor</th>
            <th style="width: 120px;">Status</th>
            <th style="width: 130px;">SLA State</th>
            <th style="width: 120px;">Assets</th>
            <th style="width: 80px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody id="videos-tbody">
          <!-- Populated dynamically -->
        </tbody>
      </table>
    </div>

    <!-- Empty State for Table -->
    <div id="videos-empty" class="empty-state" style="display: none;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);">
        <polygon points="23 7 16 12 23 17 23 7" />
        <rect x="1" y="5" width="15" height="14" rx="2" ry="2" />
      </svg>
      <p style="font-size: 0.875rem; font-weight: 600;">No videos match the current search or filters.</p>
    </div>

    <!-- Pagination & Summary Footer -->
    <div style="padding: 0.75rem 1.25rem; border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; font-size: 0.8125rem; color: var(--text-muted);">
      <div>
        Showing <span id="page-start-idx" style="font-weight: 700; color: var(--text-main);">0</span> to <span id="page-end-idx" style="font-weight: 700; color: var(--text-main);">0</span> of <span id="total-videos-count" style="font-weight: 700; color: var(--text-main);">0</span> videos
      </div>
      <div style="display: flex; gap: 0.375rem;">
        <button id="prev-page-btn" class="btn btn-secondary btn-sm" onclick="changePage(-1)" disabled>Previous</button>
        <button id="next-page-btn" class="btn btn-secondary btn-sm" onclick="changePage(1)" disabled>Next</button>
      </div>
    </div>
  </div>

  <!-- Detail Drawer Component -->
  <VideoDetailDrawer />

  <script is:inline>
    let allVideos = [];
    let filteredVideos = [];
    let currentPage = 1;
    const PAGE_SIZE = 15;

    async function loadVideosList() {
      const loading = document.getElementById('videos-loading');
      const tableContainer = document.getElementById('videos-table-container');
      const errorBox = document.getElementById('videos-error');
      const errorText = document.getElementById('videos-error-text');
      const lastUpdatedEl = document.getElementById('last-updated-text');

      if (loading) loading.style.display = 'block';
      if (tableContainer) tableContainer.style.display = 'none';
      if (errorBox) errorBox.style.display = 'none';

      try {
        const res = await fetch('/api/infinity', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'videos' })
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.ok === false) {
          throw new Error(data.error || 'Failed to load videos list');
        }

        const resObj = data.result || data.data || data;
        let rawList = [];
        if (Array.isArray(resObj)) {
          rawList = resObj;
        } else if (resObj && typeof resObj === 'object') {
          if (Array.isArray(resObj.items)) rawList = resObj.items;
          else if (Array.isArray(resObj.videos)) rawList = resObj.videos;
          else if (Array.isArray(resObj.data)) rawList = resObj.data;
        } else if (Array.isArray(data.items)) {
          rawList = data.items;
        } else if (Array.isArray(data.videos)) {
          rawList = data.videos;
        }

        normalizeAndStoreVideos(rawList);

        if (lastUpdatedEl) {
          const d = new Date();
          lastUpdatedEl.textContent = `Updated ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        }

        if (loading) loading.style.display = 'none';
        if (tableContainer) tableContainer.style.display = 'block';
      } catch (err) {
        if (loading) loading.style.display = 'none';
        if (errorBox) {
          if (errorText) errorText.textContent = err.message || 'Failed to fetch videos from server.';
          errorBox.style.display = 'block';
        }
      }
    }

    function safeVal(val) {
      if (val === null || val === undefined) return '—';
      const str = String(val).trim();
      return str === '' ? '—' : str;
    }

    function normalizeAndStoreVideos(rawList) {
      if (!Array.isArray(rawList)) {
        allVideos = [];
        filteredVideos = [];
        renderTablePage();
        return;
      }

      allVideos = rawList.map(item => {
        if (!item || typeof item !== 'object') {
          return { id: '—', title: '—', fullTitle: '', teacher: '—', editor: '—', status: '—', sla: '—', rawAvailable: false, finalAvailable: false };
        }

        const id = safeVal(item.videoId || item.id || item.video_id || item.code);
        
        const fullText = safeVal(item.scriptPreview || item.title || item.topic || item.name || item.subject);
        let title = fullText;
        if (title.includes('\n')) {
          title = title.split('\n')[0].trim();
        }

        const teacher = safeVal(item.talent || item.teacher || item.instructor);
        const editor = safeVal(item.editor || item.assignedTo);
        const status = safeVal(item.productionStatus || item.status || item.state);
        const sla = safeVal(item.slaStatus || item.sla);

        const hasRaw = Boolean(item.rawFileUrl || item.rawLink || item.rawUrl);
        const hasFinal = Boolean(item.finalFileUrl || item.finalLink || item.finalUrl);
        const hasRawFolder = Boolean(item.rawFolderUrl || item.rawFolder);
        const hasFinalFolder = Boolean(item.finalFolderUrl || item.finalFolder);

        return { id, title: title !== '—' ? title : 'Untitled Video', fullTitle: fullText, teacher, editor, status, sla, rawAvailable: hasRaw, finalAvailable: hasFinal, rawFolderAvailable: hasRawFolder, finalFolderAvailable: hasFinalFolder, rawRecord: item };
      });

      populateFilterOptions();
      applyFilters();
    }

    function populateFilterOptions() {
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      const statuses = new Set();
      const editors = new Set();

      allVideos.forEach(v => {
        if (v.status && v.status !== '—') statuses.add(v.status);
        if (v.editor && v.editor !== '—') editors.add(v.editor);
      });

      if (statusSelect) {
        const curr = statusSelect.value;
        statusSelect.innerHTML = '<option value="">All Statuses</option>';
        Array.from(statuses).sort().forEach(s => {
          const opt = document.createElement('option');
          opt.value = s;
          opt.textContent = s;
          statusSelect.appendChild(opt);
        });
        statusSelect.value = curr;
      }

      if (editorSelect) {
        const curr = editorSelect.value;
        editorSelect.innerHTML = '<option value="">All Editors</option>';
        Array.from(editors).sort().forEach(e => {
          const opt = document.createElement('option');
          opt.value = e;
          opt.textContent = e;
          editorSelect.appendChild(opt);
        });
        editorSelect.value = curr;
      }
    }

    function handleSearchChange() {
      currentPage = 1;
      applyFilters();
    }

    function handleFilterChange() {
      currentPage = 1;
      applyFilters();
    }

    function resetFilters() {
      const searchInput = document.getElementById('video-search-input');
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      if (searchInput) searchInput.value = '';
      if (statusSelect) statusSelect.value = '';
      if (editorSelect) editorSelect.value = '';

      currentPage = 1;
      applyFilters();
    }

    function applyFilters() {
      const searchInput = document.getElementById('video-search-input');
      const statusSelect = document.getElementById('status-filter-select');
      const editorSelect = document.getElementById('editor-filter-select');

      const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
      const statusFilter = statusSelect ? statusSelect.value : '';
      const editorFilter = editorSelect ? editorSelect.value : '';

      filteredVideos = allVideos.filter(v => {
        if (statusFilter && v.status !== statusFilter) return false;
        if (editorFilter && v.editor !== editorFilter) return false;

        if (query) {
          const matchId = v.id.toLowerCase().includes(query);
          const matchTitle = v.title.toLowerCase().includes(query) || v.fullTitle.toLowerCase().includes(query);
          const matchTeacher = v.teacher.toLowerCase().includes(query);
          const matchEditor = v.editor.toLowerCase().includes(query);
          if (!matchId && !matchTitle && !matchTeacher && !matchEditor) return false;
        }

        return true;
      });

      renderTablePage();
    }

    function changePage(delta) {
      const maxPage = Math.ceil(filteredVideos.length / PAGE_SIZE) || 1;
      currentPage = Math.max(1, Math.min(maxPage, currentPage + delta));
      renderTablePage();
    }

    function renderTablePage() {
      const tbody = document.getElementById('videos-tbody');
      const emptyBox = document.getElementById('videos-empty');
      const startEl = document.getElementById('page-start-idx');
      const endEl = document.getElementById('page-end-idx');
      const countEl = document.getElementById('total-videos-count');
      const prevBtn = document.getElementById('prev-page-btn');
      const nextBtn = document.getElementById('next-page-btn');

      const total = filteredVideos.length;
      const start = total === 0 ? 0 : (currentPage - 1) * PAGE_SIZE;
      const end = Math.min(start + PAGE_SIZE, total);
      const pageItems = filteredVideos.slice(start, end);

      if (startEl) startEl.textContent = total === 0 ? '0' : String(start + 1);
      if (endEl) endEl.textContent = String(end);
      if (countEl) countEl.textContent = String(total);

      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = end >= total;

      if (!tbody) return;
      tbody.innerHTML = '';

      if (pageItems.length === 0) {
        if (emptyBox) emptyBox.style.display = 'flex';
        return;
      }

      if (emptyBox) emptyBox.style.display = 'none';

      pageItems.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'clickable-row';
        tr.onclick = (e) => {
          if (e.target && (e.target.tagName === 'BUTTON' || e.target.closest('button'))) return;
          if (item.id !== '—' && typeof window.openVideoDrawer === 'function') {
            window.openVideoDrawer(item.id);
          }
        };

        const s = item.status.toLowerCase();
        const chipClass = 
          s.includes('approved') || s.includes('uploaded') || s.includes('done') ? 'chip-emerald' :
          s.includes('overdue') || s.includes('blocked') || s.includes('error') ? 'chip-red' :
          s.includes('qc') || s.includes('review') ? 'chip-purple' :
          s.includes('editing') || s.includes('in progress') ? 'chip-amber' :
          'chip-blue';

        const slaLower = item.sla.toLowerCase();
        const slaChipClass = slaLower.includes('overdue') ? 'chip-red' : (slaLower.includes('parked') ? 'chip-default' : 'chip-blue');

        tr.innerHTML = `
          <td><span class="font-mono" style="font-size: 0.75rem; font-weight: 700; color: var(--brand-700);">${item.id}</span></td>
          <td><div class="cell-title" title="${item.fullTitle}">${item.title}</div></td>
          <td><div style="color: var(--text-muted);">${item.teacher}</div></td>
          <td><div style="color: var(--text-muted); font-weight: 500;">${item.editor !== '—' ? item.editor : '<span style="color: var(--brand-700);">Unassigned</span>'}</div></td>
          <td><span class="chip ${chipClass}">${item.status}</span></td>
          <td><span class="chip ${slaChipClass}" style="font-size: 0.6875rem;">${item.sla}</span></td>
          <td>
            <div style="display: flex; gap: 0.25rem;">
              <span class="chip ${item.rawAvailable ? 'chip-emerald' : item.rawFolderAvailable ? 'chip-blue' : 'chip-default'}" title="${item.rawAvailable ? 'RAW file detected' : item.rawFolderAvailable ? 'RAW folder ready; file not detected' : 'RAW folder unavailable'}" style="font-size: 0.6875rem; padding: 0.05rem 0.35rem;">${item.rawAvailable ? 'RAW ✓' : item.rawFolderAvailable ? 'RAW folder' : 'RAW —'}</span>
              <span class="chip ${item.finalAvailable ? 'chip-emerald' : item.finalFolderAvailable ? 'chip-blue' : 'chip-default'}" title="${item.finalAvailable ? 'FINAL file detected' : item.finalFolderAvailable ? 'FINAL folder ready; file not detected' : 'FINAL folder unavailable'}" style="font-size: 0.6875rem; padding: 0.05rem 0.35rem;">${item.finalAvailable ? 'FINAL ✓' : item.finalFolderAvailable ? 'FINAL folder' : 'FINAL —'}</span>
            </div>
          </td>
          <td style="text-align: right;">
            <button class="btn btn-secondary btn-sm" onclick="window.openVideoDrawer('${item.id}')" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">
              Details
            </button>
          </td>
        `;

        tbody.appendChild(tr);
      });
    }

    // Set refresh hook
    window.__refreshOperationsData = loadVideosList;

    // Initial load
    document.addEventListener('DOMContentLoaded', () => {
      loadVideosList();
      document.getElementById('create-video-form')?.addEventListener('submit', submitCreateVideo);
    });

    function openCreateVideoModal() {
      const modal = document.getElementById('create-video-modal');
      const date = document.getElementById('create-publish-date');
      if (date && !date.value) date.value = new Date().toISOString().slice(0, 10);
      handleCreateVideoTypeChange();
      if (modal) modal.classList.add('open');
    }

    function handleCreateVideoTypeChange() {
      const type = document.getElementById('create-video-type')?.value || 'Original Recording';
      const field = document.getElementById('create-recording-script-field');
      const textarea = document.getElementById('create-recording-script');
      const required = type === 'Original Recording';
      if (field) field.style.opacity = required ? '1' : '0.72';
      if (textarea) {
        textarea.required = required;
        textarea.placeholder = required
          ? 'Exactly what the teacher should say, including hook and delivery cues...'
          : 'Optional for repurpose/existing RAW jobs.';
      }
    }

    function closeCreateVideoModal() {
      const modal = document.getElementById('create-video-modal');
      if (modal) modal.classList.remove('open');
    }

    async function submitCreateVideo(event) {
      event.preventDefault();
      const submit = document.getElementById('create-video-submit');
      const errorBox = document.getElementById('create-video-error');
      if (submit) submit.disabled = true;
      if (errorBox) errorBox.style.display = 'none';
      try {
        const payload = {
          action: 'create_video',
          videoId: document.getElementById('create-video-id').value.trim(),
          publishDate: document.getElementById('create-publish-date').value,
          talent: document.getElementById('create-teacher').value.trim(),
          teacher: document.getElementById('create-teacher').value.trim(),
          priority: document.getElementById('create-priority').value,
          videoType: document.getElementById('create-video-type').value,
          recordingScript: document.getElementById('create-recording-script').value.trim(),
          editorBrief: document.getElementById('create-editor-brief').value.trim()
        };
        payload.script = payload.recordingScript || payload.editorBrief;
        const res = await fetch('/api/infinity', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.ok === false) throw new Error(data?.error?.message || data.error || 'Could not create video');
        showToast('Script draft created', 'success');
        document.getElementById('create-video-form').reset();
        closeCreateVideoModal();
        await loadVideosList();
        const createdId = data?.result?.video?.videoId || payload.videoId;
        if (createdId && typeof window.openVideoDrawer === 'function') window.openVideoDrawer(createdId);
      } catch (error) {
        if (errorBox) { errorBox.textContent = error.message || 'Could not create video'; errorBox.style.display = 'block'; }
      } finally {
        if (submit) submit.disabled = false;
      }
    }

    window.openCreateVideoModal = openCreateVideoModal;
    window.closeCreateVideoModal = closeCreateVideoModal;
    window.submitCreateVideo = submitCreateVideo;
    window.handleCreateVideoTypeChange = handleCreateVideoTypeChange;
  </script>
</Layout>
