---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Action Jobs" activeTab="jobs">
  <div class="jobs-head card"><div><div class="today-eyebrow">RELIABILITY CENTER</div><h2>Backend action queue</h2><p>Approvals continue even if the browser closes. Failed jobs can be retried here.</p></div><button id="jobs-refresh" class="btn btn-secondary">Refresh</button></div>
  <div id="jobs-error" class="error-state" hidden></div>
  <div class="jobs-stats"><div class="card"><span>Pending</span><strong id="jobs-pending">0</strong></div><div class="card"><span>Processing</span><strong id="jobs-processing">0</strong></div><div class="card"><span>Completed</span><strong id="jobs-completed">0</strong></div><div class="card"><span>Failed</span><strong id="jobs-failed">0</strong></div></div>
  <div class="card"><div class="card-header"><h2 class="card-title">Latest 100 jobs</h2><span id="jobs-worker" class="chip chip-default">Checking worker…</span></div><div class="table-container"><table class="compact-table"><thead><tr><th>Video</th><th>Action</th><th>Status</th><th>Attempts</th><th>Updated</th><th>Error / Action</th></tr></thead><tbody id="jobs-body"></tbody></table></div><div id="jobs-empty" class="empty-state" hidden>No web actions have been queued yet.</div></div>
  <script is:inline>
    const esc = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    const unwrap = raw => raw?.result || raw?.data || raw;
    async function jobsApi(action, payload={}) { const response=await fetch('/api/infinity',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,...payload})}); const raw=await response.json().catch(()=>({})); if(!response.ok||raw.ok===false) throw new Error(raw?.error?.message||raw?.error||`Action failed: ${action}`); return unwrap(raw); }
    function statusChip(status){ const type=status==='Completed'?'emerald':status==='Failed'?'red':status==='Processing'?'blue':'amber'; return `<span class="chip chip-${type}">${esc(status)}</span>`; }
    async function loadJobs(){ const error=document.getElementById('jobs-error'); try { const data=await jobsApi('web_jobs',{refresh:true}); error.hidden=true; ['Pending','Processing','Completed','Failed'].forEach(s=>{document.getElementById(`jobs-${s.toLowerCase()}`).textContent=data.counts?.[s]||0}); const worker=document.getElementById('jobs-worker'); worker.textContent=data.worker?.ready?`Worker active · ${data.worker.handler}`:'Worker unavailable'; worker.className=`chip ${data.worker?.ready?'chip-emerald':'chip-red'}`; const jobs=Array.isArray(data.jobs)?data.jobs:[]; document.getElementById('jobs-empty').hidden=jobs.length>0; document.getElementById('jobs-body').innerHTML=jobs.map(job=>`<tr><td><a href="/videos?videoId=${encodeURIComponent(job.videoId)}">${esc(job.videoId)}</a></td><td>${esc(job.queuedAction)}</td><td>${statusChip(job.status)}</td><td>${Number(job.attemptCount||0)}/${Number(job.maxAttempts||5)}</td><td>${job.finishedAt||job.startedAt||job.createdAt?esc(new Date(job.finishedAt||job.startedAt||job.createdAt).toLocaleString()):'—'}</td><td><span class="job-error">${esc(job.error||'—')}</span>${job.status==='Failed'?` <button class="btn btn-secondary btn-sm" data-retry="${esc(job.jobId)}">Retry now</button>`:''}</td></tr>`).join(''); document.querySelectorAll('[data-retry]').forEach(button=>button.addEventListener('click',()=>retryJob(button))); document.getElementById('last-updated-text').textContent='Jobs refreshed just now'; } catch(e){ error.hidden=false; error.textContent=`${e.message}. Deploy the latest Apps Script version first.`; } }
    async function retryJob(button){ button.disabled=true; button.textContent='Queuing…'; try{await jobsApi('retry_job',{jobId:button.dataset.retry}); window.showToast?.('Job queued for retry','success'); await loadJobs();}catch(e){button.disabled=false;button.textContent='Retry now';window.showToast?.(e.message,'error');}}
    document.getElementById('jobs-refresh')?.addEventListener('click',loadJobs); document.addEventListener('DOMContentLoaded',loadJobs); setInterval(loadJobs,15000); window.__refreshOperationsData=loadJobs;
  </script>
</Layout>
<style>
.jobs-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.2rem;margin-bottom:1rem}.jobs-head h2{font-size:1.05rem}.jobs-head p{font-size:.78rem;color:var(--text-muted)}.jobs-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;margin-bottom:1rem}.jobs-stats .card{padding:1rem}.jobs-stats span{font-size:.7rem;color:var(--text-muted);text-transform:uppercase}.jobs-stats strong{display:block;font-size:1.6rem;margin-top:.2rem}.job-error{font-size:.72rem;color:var(--text-muted);margin-right:.5rem}@media(max-width:700px){.jobs-head{align-items:flex-start}.jobs-stats{grid-template-columns:repeat(2,1fr)}.compact-table{min-width:760px}}
</style>
