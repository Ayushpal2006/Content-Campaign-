---
const title = 'Infinity Operations v2';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabasePublishableKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Dashboard content is rendered client-side via innerHTML, so these rules must not be Astro-scoped. -->
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#172033;background:#f7f8fc;--pink:#db2777;--ink:#172033;--muted:#64748b;--line:#e5e7ef;--card:#fff}
      *{box-sizing:border-box}body{margin:0}.shell{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.side{background:#fff;border-right:1px solid var(--line);padding:22px 14px}.brand{font-weight:800;font-size:18px}.brand b{color:var(--pink)}.nav{display:grid;gap:6px;margin-top:30px}.nav button{border:0;background:transparent;text-align:left;border-radius:10px;padding:12px;color:#475569;font:inherit;cursor:pointer}.nav button.active,.nav button:hover{background:#fff0f7;color:#be185d;font-weight:700}.main{padding:28px;max-width:1500px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}.top h1{font-size:22px;margin:0}.sub{color:var(--muted);font-size:14px;margin:4px 0 0}.btn{border:1px solid var(--line);border-radius:9px;background:#fff;padding:10px 13px;font-weight:700;cursor:pointer}.btn.primary{background:var(--pink);border-color:var(--pink);color:#fff}.btn:disabled{opacity:.6;cursor:not-allowed}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}.metric small,.label{color:var(--muted);text-transform:uppercase;letter-spacing:.04em;font-size:11px;font-weight:800}.metric strong{display:block;font-size:30px;margin-top:8px}.split{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:16px}.list{padding:0;margin:10px 0 0;list-style:none}.item{display:flex;gap:12px;justify-content:space-between;padding:13px 0;border-top:1px solid var(--line);align-items:center}.item:first-child{border-top:0}.code{color:#be185d;font-family:ui-monospace,monospace;font-size:12px;font-weight:800}.stage{font-size:12px;border-radius:99px;background:#f3e8ff;color:#7e22ce;padding:5px 8px;white-space:nowrap}.empty{color:var(--muted);padding:32px 0;text-align:center}.drawer{position:fixed;right:0;top:0;bottom:0;width:min(510px,100vw);background:#fff;box-shadow:-20px 0 50px #17203322;transform:translateX(102%);transition:.18s;padding:24px;overflow:auto;z-index:3}.drawer.open{transform:none}.drawer-head{display:flex;justify-content:space-between;gap:10px}.drawer h2{font-size:20px;margin:5px 0 0}.drawer section{border-top:1px solid var(--line);padding:18px 0}.drawer textarea,.drawer input{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:10px;font:inherit;margin-top:7px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.note{white-space:pre-wrap;background:#fff7fa;border:1px solid #fbcfe8;border-radius:8px;padding:10px;font-size:14px}.notice{border-radius:10px;padding:12px;background:#fff1f2;color:#9f1239;margin-bottom:14px}.hidden{display:none!important}.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login .card{width:min(420px,100%)}.login input{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:8px;margin:6px 0 12px;font:inherit}.login label{font-size:13px;font-weight:700}.payout-row{display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--line)}a.asset{color:#be185d;font-weight:700;text-decoration:none;font-size:13px}@media(max-width:800px){.shell{display:block}.side{position:sticky;top:0;z-index:2;padding:10px;border-right:0;border-bottom:1px solid var(--line)}.brand{display:inline}.nav{display:flex;overflow:auto;margin:8px 0 0}.nav button{white-space:nowrap;padding:8px}.main{padding:16px}.metrics{grid-template-columns:repeat(2,1fr)}.split{grid-template-columns:1fr}.top{align-items:flex-start}.top .btn{padding:8px}.drawer{padding:18px}}
      h2{margin:7px 0 5px;font-size:19px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:0 0 14px}.toolbar input,.toolbar select,.settings-grid input,.settings-grid textarea{border:1px solid #cbd5e1;border-radius:9px;background:#fff;padding:10px;font:inherit;color:var(--ink)}.toolbar input{min-width:min(330px,100%);flex:1}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:720px}.table th{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;text-align:left;padding:11px;border-bottom:1px solid var(--line)}.table td{padding:13px 11px;border-bottom:1px solid var(--line);vertical-align:top}.table tr:hover{background:#fffbfd}.title{font-weight:800}.soft{font-size:12px;color:var(--muted);margin-top:4px}.pill{display:inline-flex;align-items:center;border-radius:999px;padding:4px 8px;font-size:12px;font-weight:700}.pill.qc_pending{background:#f3e8ff;color:#7e22ce}.pill.changes_required{background:#fff1f2;color:#be123c}.pill.approved{background:#ecfdf5;color:#047857}.pill.uploaded{background:#dbeafe;color:#1d4ed8}.pill.editing{background:#fff7ed;color:#c2410c}.pill.default{background:#f1f5f9;color:#475569}.focus{border:1px solid #fbcfe8;background:linear-gradient(90deg,#fff7fa,#fff);border-radius:14px;padding:16px}.focus strong{font-size:16px}.kpi{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.kpi .card{padding:14px}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.settings-grid textarea{min-height:96px;grid-column:1/-1}.action-card{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:13px;border:1px solid var(--line);border-radius:11px;margin-top:10px}.action-card .actions{margin:0}.mutedbox{border:1px dashed #cbd5e1;background:#f8fafc;border-radius:10px;padding:14px;color:var(--muted);font-size:14px}.mobile-only{display:none}@media(max-width:800px){.kpi{grid-template-columns:repeat(2,minmax(0,1fr))}.table{min-width:630px}.toolbar input{min-width:100%}.settings-grid{grid-template-columns:1fr}.action-card{align-items:flex-start;flex-direction:column}.mobile-only{display:inline}.drawer .btn{min-height:44px}.nav button{min-height:42px}.side{box-shadow:0 2px 9px #1720330a}.main{padding-bottom:40px}}
    </style>
  </head>
  <body>
    <div id="login-view" class="login">
      <form id="login-form" class="card">
        <div class="brand">Infinity <b>Operations</b> v2</div>
        <h1>Sign in</h1><p class="sub">Use your assigned manager or editor account.</p>
        <div id="login-error" class="notice hidden"></div>
        <label>Email<input id="email" type="email" autocomplete="email" required /></label>
        <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
        <button class="btn primary" style="width:100%">Sign in</button>
      </form>
    </div>
    <div id="app-view" class="shell hidden">
      <aside class="side"><div class="brand">Infinity <b>Operations</b></div><nav class="nav" id="nav"><button data-tab="dashboard" class="active">Today</button><button data-tab="qc">QC Inbox</button><button data-tab="videos">All Videos</button><button data-tab="publish">Publish & Upload</button><button data-tab="work">My Work</button><button data-tab="load">Editor Load</button><button data-tab="payouts">Payouts</button><button data-tab="mis">Daily MIS</button><button data-tab="settings">Settings</button><button id="logout">Log out</button></nav></aside>
      <main class="main"><div class="top"><div><h1 id="heading">Manager dashboard</h1><p id="identity" class="sub"></p></div><button id="refresh" class="btn">Refresh</button></div><div id="error" class="notice hidden"></div><div id="content"></div></main>
    </div>
    <aside id="drawer" class="drawer"><div class="drawer-head"><div><span class="label">Video details</span><h2 id="drawer-title">—</h2></div><button class="btn" id="close">Close</button></div><div id="drawer-content"></div></aside>
    <script is:inline define:vars={{ supabaseUrl, supabasePublishableKey }}>
      window.INFINITY_V2_CONFIG = { url: supabaseUrl, key: supabasePublishableKey };
    </script>
    <script is:inline type="module">
      // @ts-nocheck
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.116.0';
      const { url, key } = window.INFINITY_V2_CONFIG;
      const el = (id) => document.getElementById(id);
      const esc = (value='') => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      let db, profile, videos = [], people = [], activeTab = 'dashboard', currentVideo, videoLimit = 30;
      const stageLabel = s => ({script_draft:'Script',script_ready:'Script ready',recording:'Recording',raw_ready:'RAW ready',editing:'Editing',qc_pending:'QC pending',changes_required:'Changes required',approved:'Approved',uploaded:'Published'}[s] || s);
      function error(message){ const box=el('error'); box.textContent=message; box.classList.remove('hidden'); }
      function clearError(){el('error').classList.add('hidden')}
      function assets(v){return [['RAW file',v.raw_file_url],['RAW folder',v.raw_folder_url],['FINAL file',v.final_file_url],['FINAL folder',v.final_folder_url],['Published post',v.published_url]].filter(([,u])=>u).map(([n,u])=>`<a class="asset" href="${esc(u)}" target="_blank" rel="noopener">${n} ↗</a>`).join(' · ') || '<span class="sub">No asset links yet</span>'}
      async function load(){
        clearError(); const [{data:videoData,error:videoErr},{data:profileData,error:profileErr}] = await Promise.all([db.from('videos').select('*').order('updated_at',{ascending:false}),db.from('profiles').select('*')]);
        if(videoErr||profileErr) throw new Error(videoErr?.message||profileErr?.message);
        const { data: { user } } = await db.auth.getUser();
        videos=videoData||[]; people=profileData||[]; profile=people.find(p=>p.id===user?.id);
        if(!profile && people.length===0){
          const { data: firstManager, error: bootstrapError } = await db.rpc('bootstrap_first_manager',{display_name_input:user?.email?.split('@')[0]||'Manager'});
          if(bootstrapError) throw new Error(bootstrapError.message);
          profile=firstManager; people=[firstManager];
        }
        if(!profile) throw new Error('Your account is signed in but has not been provisioned. Ask a manager to add your profile.');
        el('identity').textContent=`${profile.display_name} · ${profile.role}`; render();
      }
      function videoRows(items,cta='Open'){return items.length?`<ul class="list">${items.map(v=>`<li class="item"><div><div class="code">${esc(v.video_code)}</div><strong>${esc(v.title)}</strong><div class="sub">${assets(v)}</div></div><div><span class="stage">${stageLabel(v.stage)}</span><button class="btn" data-open="${v.id}" style="margin-left:8px">${cta}</button></div></li>`).join('')}</ul>`:'<div class="empty">Nothing here yet.</div>'}
      const pill=s=>`<span class="pill ${['qc_pending','changes_required','approved','uploaded','editing'].includes(s)?s:'default'}">${stageLabel(s)}</span>`;
      const isToday=v=>new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata'}).format(new Date(v.updated_at))===new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Kolkata'}).format(new Date());
      function bindOpen(){document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>openDrawer(videos.find(v=>v.id===b.dataset.open)))}
      function compactRows(items,cta='Open'){return items.length?`<ul class="list">${items.map(v=>`<li class="item"><div><div class="code">${esc(v.video_code)}</div><strong>${esc(v.title)}</strong><div class="sub">${esc(v.talent_name||'No teacher')} · ${esc(v.source_editor_name||'Unassigned')}</div></div><div class="actions">${pill(v.stage)}<button class="btn" data-open="${v.id}">${cta}</button></div></li>`).join('')}</ul>`:'<div class="empty">Nothing needs attention right now.</div>'}
      function render(){
        const own=profile.role==='editor'?videos.filter(v=>v.assigned_editor_id===profile.id):videos;
        const qc=videos.filter(v=>v.stage==='qc_pending'),changes=videos.filter(v=>v.stage==='changes_required'),approved=videos.filter(v=>v.stage==='approved'),published=videos.filter(v=>v.stage==='uploaded'),today=videos.filter(isToday);
        if(activeTab==='dashboard'){
          el('heading').textContent='Today';el('content').innerHTML=`<section class="card"><span class="label">Today’s operations</span><h2>Prioritise QC, then publish approved videos</h2><p class="sub">${videos.length} active videos in the workspace. The “worked today” count will be reliable from tomorrow because the initial migration happened today.</p></section><div class="metrics" style="margin-top:14px"><div class="card metric"><small>QC waiting</small><strong>${qc.length}</strong></div><div class="card metric"><small>Changes</small><strong>${changes.length}</strong></div><div class="card metric"><small>Ready to upload</small><strong>${approved.length}</strong></div><div class="card metric"><small>Published</small><strong>${published.length}</strong></div></div><div class="split"><section class="card"><span class="label">1. Decide now</span><h2>QC waiting</h2>${compactRows(qc.slice(0,5),'Review')}</section><section class="card"><span class="label">2. Upload next</span><h2>Approved videos</h2>${compactRows(approved.slice(0,5),'Upload')}</section></div>`;
        } else if(activeTab==='qc') {el('heading').textContent='QC Inbox';el('content').innerHTML=`<section class="card"><span class="label">Manager action</span><h2>Approve or request one clear revision</h2><p class="sub">Open a video, then approve in one click or send it back with a note.</p>${compactRows(qc,'Review')}</section>`}
        else if(activeTab==='videos') {el('heading').textContent='All Videos';el('content').innerHTML=`<section class="card"><div class="toolbar" style="display:flex;gap:10px;flex-wrap:wrap"><input id="video-search" style="flex:1;min-width:260px" placeholder="Search title, Video ID, teacher or editor" /><select id="stage-filter"><option value="">All stages</option>${['qc_pending','changes_required','editing','approved','uploaded'].map(s=>`<option value="${s}">${stageLabel(s)}</option>`).join('')}</select></div><div id="video-results"></div></section>`;const draw=()=>{const q=el('video-search').value.toLowerCase(),f=el('stage-filter').value;const items=videos.filter(v=>(!f||v.stage===f)&&[v.video_code,v.title,v.talent_name,v.source_editor_name].join(' ').toLowerCase().includes(q));const shown=items.slice(0,videoLimit);el('video-results').innerHTML=`<p class="sub">Showing ${shown.length} of ${items.length} videos</p>${compactRows(shown,'Open')}${items.length>shown.length?'<button id="show-more" class="btn">Show 30 more</button>':''}`;el('show-more')?.addEventListener('click',()=>{videoLimit+=30;draw()});bindOpen()};el('video-search').oninput=()=>{videoLimit=30;draw()};el('stage-filter').onchange=()=>{videoLimit=30;draw()};draw()}
        else if(activeTab==='publish') {el('heading').textContent='Publish & Upload';el('content').innerHTML=`<section class="card"><span class="label">Ready to post</span><h2>Approved videos awaiting publishing</h2><p class="sub">Open a video, paste its public post link, and mark it published. Final and RAW folders remain available for the external MIS.</p>${compactRows(approved,'Mark published')}</section>`}
        else if(activeTab==='work') {el('heading').textContent='My Work';el('content').innerHTML=`<section class="card"><span class="label">Personal queue</span><h2>${profile.role==='editor'?'Only your secure assignments':'Manager view'}</h2>${profile.role==='editor'?videoRows(own,'Open'):`<div class="mutedbox">Editor accounts are not linked to imported Sheet names yet. Create each editor’s Supabase login first; then their My Work page will show only their assigned videos.</div>${compactRows(videos.filter(v=>v.stage==='editing'||v.stage==='changes_required').slice(0,12),'Open')}`}</section>`}
        else if(activeTab==='load') {el('heading').textContent='Editor Load';const groups=Object.entries(videos.reduce((m,v)=>{const n=v.source_editor_name||'Unassigned';m[n]=(m[n]||0)+(['editing','changes_required','qc_pending'].includes(v.stage)?1:0);return m},{}));el('content').innerHTML=`<section class="card"><span class="label">Manager-only planning</span><h2>Current active load by imported editor name</h2><div class="table-wrap"><table class="table"><thead><tr><th>Editor</th><th>Active workload</th><th>Account status</th></tr></thead><tbody>${groups.sort((a,b)=>b[1]-a[1]).map(([n,c])=>`<tr><td class="title">${esc(n)}</td><td>${c} active item${c===1?'':'s'}</td><td class="soft">Login link pending</td></tr>`).join('')}</tbody></table></div></section>`}
        else if(activeTab==='payouts') renderPayouts();
        else if(activeTab==='mis') renderMis(published,qc,approved);
        else renderSettings();
        bindOpen();
      }
      async function renderPayouts(){
        el('heading').textContent='Payouts';const {data,error:err}=await db.from('payout_entries').select('*').order('created_at',{ascending:false});if(err)return error(err.message);const total=(data||[]).filter(x=>x.status==='pending').reduce((s,x)=>s+Number(x.amount),0);el('content').innerHTML=`<section class="card"><span class="label">Payable calculation</span><h2>Pending: ₹${total.toFixed(2)}</h2><p class="sub">₹50 is recorded when an editor submits a final revision for QC; ₹10 is added once the video is marked published. Managers can later add fixed salary and adjustments.</p>${(data||[]).map(x=>`<div class="payout-row"><span>${esc(x.entry_type.replace('_',' '))}</span><strong>₹${Number(x.amount).toFixed(2)}</strong></div>`).join('')||'<div class="empty">No payout entries yet.</div>'}</section>`}
      async function renderMis(published,qc,approved){el('heading').textContent='Daily MIS';const {data:settings}=await db.from('mis_settings').select('*').eq('singleton',true).maybeSingle();el('content').innerHTML=`<section class="card"><span class="label">External management report</span><h2>Delivery register</h2><p class="sub">This preview deliberately excludes editor names, internal workload, revision notes and operational decisions.</p><div class="kpi"><div class="card metric"><small>Published</small><strong>${published.length}</strong></div><div class="card metric"><small>Ready</small><strong>${approved.length}</strong></div><div class="card metric"><small>QC waiting</small><strong>${qc.length}</strong></div></div><h3>Shareable links</h3>${compactRows(videos.filter(v=>v.stage==='uploaded'||v.final_folder_url||v.raw_folder_url).slice(0,60),'Open')}</section><section class="card" style="margin-top:16px"><span class="label">Schedule</span><h2>${settings?.recipient_emails?.length?'Configured for '+settings.recipient_emails.join(', '):'Recipients not configured'}</h2><p class="sub">Configured send window: ${settings?.send_hour??20}:00 Asia/Kolkata. Email automation needs a secure server-side sender before it can be enabled; preview and recipients are ready here.</p></section>`}
      async function renderSettings(){el('heading').textContent='Settings';if(profile.role!=='manager'){el('content').innerHTML='<section class="card"><h2>Manager access required</h2><p class="sub">Only managers can change operational settings.</p></section>';return}const {data:settings}=await db.from('mis_settings').select('*').eq('singleton',true).maybeSingle();const control='width:100%;margin-top:6px;padding:10px;border:1px solid #cbd5e1;border-radius:8px;font:inherit';el('content').innerHTML=`<section class="card"><span class="label">Daily MIS settings</span><h2>Recipients and send window</h2><p class="sub">Use comma-separated email addresses. Saving here does not auto-send an email yet.</p><div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px"><label>To<input style="${control}" id="mis-to" value="${esc((settings?.recipient_emails||[]).join(', '))}" placeholder="manager@example.com" /></label><label>CC<input style="${control}" id="mis-cc" value="${esc((settings?.cc_emails||[]).join(', '))}" placeholder="optional@example.com" /></label><label>Daily send hour (Asia/Kolkata)<input style="${control}" id="mis-hour" type="number" min="0" max="23" value="${settings?.send_hour??20}" /></label><label>Timezone<input style="${control}" value="Asia/Kolkata" disabled /></label><label style="grid-column:1/-1">External management note<textarea style="${control};min-height:96px" id="mis-note" placeholder="Optional external management context">${esc(settings?.external_summary_note||'')}</textarea></label></div><div class="actions"><button id="save-settings" class="btn primary">Save settings</button></div></section><section class="card" style="margin-top:16px"><span class="label">Editor access</span><h2>Create editor logins safely</h2><p class="sub">Imported editor names are migration labels only. Do not share manager credentials. Create each editor in Supabase Auth, then link their profile before assigning videos.</p></section>`;el('save-settings').onclick=async()=>{const emails=id=>el(id).value.split(',').map(x=>x.trim()).filter(Boolean);const payload={singleton:true,recipient_emails:emails('mis-to'),cc_emails:emails('mis-cc'),send_hour:Number(el('mis-hour').value),timezone:'Asia/Kolkata',external_summary_note:el('mis-note').value.trim()||null,updated_by:profile.id,updated_at:new Date().toISOString()};const {error:err}=await db.from('mis_settings').upsert(payload);if(err)return error(err.message);clearError();renderSettings()}}
      function openDrawer(v){currentVideo=v;el('drawer-title').textContent=v.title;const manager=profile.role==='manager';const msg=encodeURIComponent(`Video: ${v.title}\nRAW: ${v.raw_folder_url||v.raw_file_url||'—'}\nFINAL: ${v.final_folder_url||v.final_file_url||'—'}`);const qcActions=v.stage==='qc_pending'?`<section><span class="label">QC decision</span><textarea id="note" placeholder="Write a clear revision note only when changes are required."></textarea><div class="actions"><button id="changes" class="btn">Request changes</button><button id="approve" class="btn primary">Approve QC</button></div></section>`:'';const publishAction=v.stage==='approved'?`<section><span class="label">Publish & upload</span><input id="post-url" placeholder="Public Instagram / YouTube post link" value="${esc(v.published_url||'')}"><input id="account" placeholder="Channel / account name" value="${esc(v.account_name||'')}"><div class="actions"><button id="publish" class="btn primary">Mark published</button></div></section>`:'';el('drawer-content').innerHTML=`<section>${pill(v.stage)}<p class="sub">${esc(v.video_code)} · ${esc(v.talent_name||'No talent')}</p><div>${assets(v)}</div></section>${v.revision_note?`<section><span class="label">Latest change note</span><div class="note">${esc(v.revision_note)}</div></section>`:''}${manager?qcActions+publishAction:`<section><span class="label">Editor action</span><p class="sub">When your final revision is ready, submit it for manager QC.</p><button id="submit-qc" class="btn primary">Submit revision for QC</button></section>`}<section><a class="btn" target="_blank" rel="noopener" href="https://wa.me/?text=${msg}">Open WhatsApp message</a></section><section><span class="label">Activity</span><div id="history" class="sub">Loading…</div></section>`;el('drawer').classList.add('open');if(manager){if(el('approve'))el('approve').onclick=()=>stage('approved',null);if(el('changes'))el('changes').onclick=()=>stage('changes_required',el('note').value);if(el('publish'))el('publish').onclick=()=>publishVideo()}else el('submit-qc').onclick=()=>stage('qc_pending',null);loadHistory(v.id)}
      async function loadHistory(id){const {data}=await db.from('video_events').select('*').eq('video_id',id).order('created_at',{ascending:false});const box=el('history');if(box)box.innerHTML=(data||[]).map(e=>`<div class="payout-row"><span>${esc(e.event_type.replace('_',' '))}<br>${esc(e.note||'')}</span><span>${new Date(e.created_at).toLocaleString()}</span></div>`).join('')||'No recorded activity.'}
      async function publishVideo(){const link=el('post-url').value.trim();if(!link)return error('Paste the public post link before marking this video published.');const buttons=el('drawer').querySelectorAll('button');buttons.forEach(b=>b.disabled=true);const {error:err}=await db.rpc('record_publish',{target_video_id:currentVideo.id,post_url_input:link,account_input:el('account').value.trim()||null,action_note:'Marked published from operations app'});if(err){buttons.forEach(b=>b.disabled=false);return error(err.message)}await load();openDrawer(videos.find(v=>v.id===currentVideo.id));}
      async function stage(next,note){if(next==='changes_required'&&!note?.trim())return error('Add a clear change note before sending it.');const buttons=el('drawer').querySelectorAll('button');buttons.forEach(b=>b.disabled=true);const {error:err}=await db.rpc('set_video_stage',{target_video_id:currentVideo.id,target_stage:next,action_note:note||null});if(err){buttons.forEach(b=>b.disabled=false);return error(err.message)}await load();openDrawer(videos.find(v=>v.id===currentVideo.id));}
      async function boot(){if(!url||!key){el('login-error').textContent='Missing PUBLIC_SUPABASE_URL or PUBLIC_SUPABASE_PUBLISHABLE_KEY.';el('login-error').classList.remove('hidden');return}db=createClient(url,key);const {data:{session}}=await db.auth.getSession();if(session){el('login-view').classList.add('hidden');el('app-view').classList.remove('hidden');try{await load()}catch(e){error(e.message)}}}
      el('login-form').onsubmit=async e=>{e.preventDefault();const {error:err}=await (db||createClient(url,key)).auth.signInWithPassword({email:el('email').value,password:el('password').value});if(err){el('login-error').textContent=err.message;el('login-error').classList.remove('hidden')}else location.reload()};
      el('nav').onclick=e=>{const b=e.target.closest('[data-tab]');if(!b)return;activeTab=b.dataset.tab;document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));render()};el('refresh').onclick=()=>load().catch(e=>error(e.message));el('close').onclick=()=>el('drawer').classList.remove('open');el('logout').onclick=async()=>{await db.auth.signOut();location.reload()};boot();
    </script>
  </body>
</html>
