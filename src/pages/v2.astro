---
const title = 'Infinity Operations v2';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#172033;background:#f7f8fc;--pink:#db2777;--ink:#172033;--muted:#64748b;--line:#e5e7ef;--card:#fff}
      *{box-sizing:border-box}body{margin:0}.shell{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.side{background:#fff;border-right:1px solid var(--line);padding:22px 14px}.brand{font-weight:800;font-size:18px}.brand b{color:var(--pink)}.nav{display:grid;gap:6px;margin-top:30px}.nav button{border:0;background:transparent;text-align:left;border-radius:10px;padding:12px;color:#475569;font:inherit;cursor:pointer}.nav button.active,.nav button:hover{background:#fff0f7;color:#be185d;font-weight:700}.main{padding:28px;max-width:1500px;width:100%;margin:auto}.top{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:20px}.top h1{font-size:22px;margin:0}.sub{color:var(--muted);font-size:14px;margin:4px 0 0}.btn{border:1px solid var(--line);border-radius:9px;background:#fff;padding:10px 13px;font-weight:700;cursor:pointer}.btn.primary{background:var(--pink);border-color:var(--pink);color:#fff}.btn:disabled{opacity:.6;cursor:not-allowed}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}.metric small,.label{color:var(--muted);text-transform:uppercase;letter-spacing:.04em;font-size:11px;font-weight:800}.metric strong{display:block;font-size:30px;margin-top:8px}.split{display:grid;grid-template-columns:1.25fr .75fr;gap:16px;margin-top:16px}.list{padding:0;margin:10px 0 0;list-style:none}.item{display:flex;gap:12px;justify-content:space-between;padding:13px 0;border-top:1px solid var(--line);align-items:center}.item:first-child{border-top:0}.code{color:#be185d;font-family:ui-monospace,monospace;font-size:12px;font-weight:800}.stage{font-size:12px;border-radius:99px;background:#f3e8ff;color:#7e22ce;padding:5px 8px;white-space:nowrap}.empty{color:var(--muted);padding:32px 0;text-align:center}.drawer{position:fixed;right:0;top:0;bottom:0;width:min(510px,100vw);background:#fff;box-shadow:-20px 0 50px #17203322;transform:translateX(102%);transition:.18s;padding:24px;overflow:auto;z-index:3}.drawer.open{transform:none}.drawer-head{display:flex;justify-content:space-between;gap:10px}.drawer h2{font-size:20px;margin:5px 0 0}.drawer section{border-top:1px solid var(--line);padding:18px 0}.drawer textarea,.drawer input{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:10px;font:inherit;margin-top:7px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.note{white-space:pre-wrap;background:#fff7fa;border:1px solid #fbcfe8;border-radius:8px;padding:10px;font-size:14px}.notice{border-radius:10px;padding:12px;background:#fff1f2;color:#9f1239;margin-bottom:14px}.hidden{display:none!important}.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login .card{width:min(420px,100%)}.login input{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:8px;margin:6px 0 12px;font:inherit}.login label{font-size:13px;font-weight:700}.payout-row{display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--line)}a.asset{color:#be185d;font-weight:700;text-decoration:none;font-size:13px}@media(max-width:800px){.shell{display:block}.side{position:sticky;top:0;z-index:2;padding:10px;border-right:0;border-bottom:1px solid var(--line)}.brand{display:inline}.nav{display:flex;overflow:auto;margin:8px 0 0}.nav button{white-space:nowrap;padding:8px}.main{padding:16px}.metrics{grid-template-columns:repeat(2,1fr)}.split{grid-template-columns:1fr}.top{align-items:flex-start}.top .btn{padding:8px}.drawer{padding:18px}}
    </style>
  </head>
  <body>
    <div id="login-view" class="login">
      <form id="login-form" class="card">
        <div class="brand">Infinity <b>Operations</b> v2</div>
        <h1>Sign in</h1><p class="sub">Use your assigned manager or editor account.</p>
        <div id="login-error" class="notice hidden"></div>
        <label>Email<input id="email" type="email" autocomplete="email" required /></label>
        <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
        <button class="btn primary" style="width:100%">Sign in</button>
      </form>
    </div>
    <div id="app-view" class="shell hidden">
      <aside class="side"><div class="brand">Infinity <b>Operations</b></div><nav class="nav" id="nav"><button data-tab="dashboard" class="active">Overview</button><button data-tab="videos">Videos</button><button data-tab="work">My Work</button><button data-tab="payouts">Payouts</button><button data-tab="mis">Daily MIS</button><button id="logout">Log out</button></nav></aside>
      <main class="main"><div class="top"><div><h1 id="heading">Manager dashboard</h1><p id="identity" class="sub"></p></div><button id="refresh" class="btn">Refresh</button></div><div id="error" class="notice hidden"></div><div id="content"></div></main>
    </div>
    <aside id="drawer" class="drawer"><div class="drawer-head"><div><span class="label">Video details</span><h2 id="drawer-title">—</h2></div><button class="btn" id="close">Close</button></div><div id="drawer-content"></div></aside>
    <script>
      // @ts-nocheck
      import { createClient } from '@supabase/supabase-js';
      const url = import.meta.env.PUBLIC_SUPABASE_URL;
      const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
      const el = (id) => document.getElementById(id);
      const esc = (value='') => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      let db, profile, videos = [], people = [], activeTab = 'dashboard', currentVideo;
      const stageLabel = s => ({script_draft:'Script',script_ready:'Script ready',recording:'Recording',raw_ready:'RAW ready',editing:'Editing',qc_pending:'QC pending',changes_required:'Changes required',approved:'Approved',uploaded:'Published'}[s] || s);
      function error(message){ const box=el('error'); box.textContent=message; box.classList.remove('hidden'); }
      function clearError(){el('error').classList.add('hidden')}
      function assets(v){return [['RAW file',v.raw_file_url],['RAW folder',v.raw_folder_url],['FINAL file',v.final_file_url],['FINAL folder',v.final_folder_url],['Published post',v.published_url]].filter(([,u])=>u).map(([n,u])=>`<a class="asset" href="${esc(u)}" target="_blank" rel="noopener">${n} ↗</a>`).join(' · ') || '<span class="sub">No asset links yet</span>'}
      async function load(){
        clearError(); const [{data:videoData,error:videoErr},{data:profileData,error:profileErr}] = await Promise.all([db.from('videos').select('*').order('updated_at',{ascending:false}),db.from('profiles').select('*')]);
        if(videoErr||profileErr) throw new Error(videoErr?.message||profileErr?.message);
        const { data: { user } } = await db.auth.getUser();
        videos=videoData||[]; people=profileData||[]; profile=people.find(p=>p.id===user?.id);
        if(!profile && people.length===0){
          const { data: firstManager, error: bootstrapError } = await db.rpc('bootstrap_first_manager',{display_name_input:user?.email?.split('@')[0]||'Manager'});
          if(bootstrapError) throw new Error(bootstrapError.message);
          profile=firstManager; people=[firstManager];
        }
        if(!profile) throw new Error('Your account is signed in but has not been provisioned. Ask a manager to add your profile.');
        el('identity').textContent=`${profile.display_name} · ${profile.role}`; render();
      }
      function videoRows(items,cta='Open'){return items.length?`<ul class="list">${items.map(v=>`<li class="item"><div><div class="code">${esc(v.video_code)}</div><strong>${esc(v.title)}</strong><div class="sub">${assets(v)}</div></div><div><span class="stage">${stageLabel(v.stage)}</span><button class="btn" data-open="${v.id}" style="margin-left:8px">${cta}</button></div></li>`).join('')}</ul>`:'<div class="empty">Nothing here yet.</div>'}
      function render(){
        const own=profile.role==='editor'?videos.filter(v=>v.assigned_editor_id===profile.id):videos;
        if(activeTab==='dashboard'){
          const qc=videos.filter(v=>v.stage==='qc_pending'),changes=videos.filter(v=>v.stage==='changes_required'),published=videos.filter(v=>v.stage==='uploaded'),today=videos.filter(v=>new Date(v.updated_at).toDateString()===new Date().toDateString());
          el('heading').textContent='Manager dashboard'; el('content').innerHTML=`<div class="metrics"><div class="card metric"><small>Needs QC</small><strong>${qc.length}</strong></div><div class="card metric"><small>Changes</small><strong>${changes.length}</strong></div><div class="card metric"><small>Published</small><strong>${published.length}</strong></div><div class="card metric"><small>Worked today</small><strong>${today.length}</strong></div></div><div class="split"><section class="card"><span class="label">Fast decisions</span><h2>QC waiting now</h2>${videoRows(qc,'Decide')}</section><section class="card"><span class="label">Today</span><h2>Recent activity</h2>${videoRows(videos.slice(0,6),'Open')}</section></div>`;
        } else if(activeTab==='videos') {el('heading').textContent='Videos';el('content').innerHTML=`<section class="card"><span class="label">All workflow items</span>${videoRows(videos)}</section>`}
        else if(activeTab==='work') {el('heading').textContent='My work';el('content').innerHTML=`<section class="card"><span class="label">Only your assigned work</span>${videoRows(own,'Open')}</section>`}
        else if(activeTab==='payouts') renderPayouts();
        else {el('heading').textContent='Daily MIS';el('content').innerHTML=`<section class="card"><span class="label">Manager-facing report</span><h2>Today’s delivery picture</h2><p class="sub">The scheduled email will show published links, or RAW and FINAL links when publishing is pending. Editor names and internal workflow details are excluded.</p><div class="metrics" style="margin-top:16px"><div class="card metric"><small>Published</small><strong>${videos.filter(v=>v.stage==='uploaded').length}</strong></div><div class="card metric"><small>QC pending</small><strong>${videos.filter(v=>v.stage==='qc_pending').length}</strong></div></div><h3>External asset register</h3>${videoRows(videos.filter(v=>v.stage==='uploaded'||v.raw_folder_url||v.final_folder_url),'Open')}</section>`}
        document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>openDrawer(videos.find(v=>v.id===b.dataset.open)));
      }
      async function renderPayouts(){
        el('heading').textContent='Payouts';const {data,error:err}=await db.from('payout_entries').select('*').order('created_at',{ascending:false});if(err)return error(err.message);const total=(data||[]).filter(x=>x.status==='pending').reduce((s,x)=>s+Number(x.amount),0);el('content').innerHTML=`<section class="card"><span class="label">Payable calculation</span><h2>Pending: ₹${total.toFixed(2)}</h2><p class="sub">₹50 is recorded when an editor submits a final revision for QC; ₹10 is added once the video is marked published. Managers can later add fixed salary and adjustments.</p>${(data||[]).map(x=>`<div class="payout-row"><span>${esc(x.entry_type.replace('_',' '))}</span><strong>₹${Number(x.amount).toFixed(2)}</strong></div>`).join('')||'<div class="empty">No payout entries yet.</div>'}</section>`}
      function openDrawer(v){currentVideo=v;el('drawer-title').textContent=v.title;const manager=profile.role==='manager';const msg=encodeURIComponent(`Video: ${v.title}\n${v.revision_note?'Revision note: '+v.revision_note+'\n':''}RAW: ${v.raw_folder_url||v.raw_file_url||'—'}\nFINAL: ${v.final_folder_url||v.final_file_url||'—'}`);el('drawer-content').innerHTML=`<section><span class="stage">${stageLabel(v.stage)}</span><p class="sub">${esc(v.video_code)}</p><div>${assets(v)}</div></section>${v.revision_note?`<section><span class="label">Latest change note</span><div class="note">${esc(v.revision_note)}</div></section>`:''}${manager?`<section><span class="label">QC decision</span><textarea id="note" placeholder="Revision note is required only if requesting changes."></textarea><div class="actions"><button id="changes" class="btn">Request changes</button><button id="approve" class="btn primary">Approve QC</button></div></section>`:`<section><span class="label">Editor action</span><p class="sub">When final revision is ready, submit it for manager QC.</p><button id="submit-qc" class="btn primary">Submit revision for QC</button></section>`}<section><a class="btn" target="_blank" rel="noopener" href="https://wa.me/?text=${msg}">Open WhatsApp message</a></section><section><span class="label">Activity</span><div id="history" class="sub">Loading…</div></section>`;el('drawer').classList.add('open');if(manager){el('approve').onclick=()=>stage('approved',null);el('changes').onclick=()=>stage('changes_required',el('note').value)}else el('submit-qc').onclick=()=>stage('qc_pending',null);loadHistory(v.id)}
      async function loadHistory(id){const {data}=await db.from('video_events').select('*').eq('video_id',id).order('created_at',{ascending:false});const box=el('history');if(box)box.innerHTML=(data||[]).map(e=>`<div class="payout-row"><span>${esc(e.event_type.replace('_',' '))}<br>${esc(e.note||'')}</span><span>${new Date(e.created_at).toLocaleString()}</span></div>`).join('')||'No recorded activity.'}
      async function stage(next,note){if(next==='changes_required'&&!note?.trim())return error('Add a clear change note before sending it.');const buttons=el('drawer').querySelectorAll('button');buttons.forEach(b=>b.disabled=true);const {error:err}=await db.rpc('set_video_stage',{target_video_id:currentVideo.id,target_stage:next,action_note:note||null});if(err){buttons.forEach(b=>b.disabled=false);return error(err.message)}await load();openDrawer(videos.find(v=>v.id===currentVideo.id));}
      async function boot(){if(!url||!key){el('login-error').textContent='Missing PUBLIC_SUPABASE_URL or PUBLIC_SUPABASE_PUBLISHABLE_KEY.';el('login-error').classList.remove('hidden');return}db=createClient(url,key);const {data:{session}}=await db.auth.getSession();if(session){el('login-view').classList.add('hidden');el('app-view').classList.remove('hidden');try{await load()}catch(e){error(e.message)}}}
      el('login-form').onsubmit=async e=>{e.preventDefault();const {error:err}=await (db||createClient(url,key)).auth.signInWithPassword({email:el('email').value,password:el('password').value});if(err){el('login-error').textContent=err.message;el('login-error').classList.remove('hidden')}else location.reload()};
      el('nav').onclick=e=>{const b=e.target.closest('[data-tab]');if(!b)return;activeTab=b.dataset.tab;document.querySelectorAll('[data-tab]').forEach(x=>x.classList.toggle('active',x===b));render()};el('refresh').onclick=()=>load().catch(e=>error(e.message));el('close').onclick=()=>el('drawer').classList.remove('open');el('logout').onclick=async()=>{await db.auth.signOut();location.reload()};boot();
    </script>
  </body>
</html>
