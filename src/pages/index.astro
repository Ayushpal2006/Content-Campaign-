---
import Layout from '../layouts/Layout.astro';
import VideoDetailDrawer from '../components/VideoDetailDrawer.astro';
---

<Layout title="Control Tower" activeTab="dashboard">
  <!-- Error Banner -->
  <div id="dashboard-error" class="error-state" style="display: none; margin-bottom: 1.25rem;">
    <div style="font-weight: 700; font-size: 0.95rem;">Unable to load dashboard data</div>
    <p id="dashboard-error-text" style="font-size: 0.8125rem; margin-top: 0.25rem;">Failed to communicate with operations backend.</p>
    <button class="btn btn-primary btn-sm" onclick="loadDashboardData()" style="margin-top: 0.5rem;">
      Retry Connection
    </button>
  </div>

  <!-- Loading Skeletons -->
  <div id="dashboard-skeletons" style="display: block;">
    <div class="metrics-grid">
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem; align-items: start;">
      <div class="card" style="padding: 1.25rem; height: 320px;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text"></div>
      </div>
      <div class="card" style="padding: 1.25rem; height: 320px;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text"></div>
      </div>
    </div>
  </div>

  <!-- Dynamic Dashboard Content -->
  <div id="dashboard-content" style="display: none;">
    <section class="today-mission card" aria-labelledby="today-mission-title">
      <div class="today-mission-copy">
        <span class="today-eyebrow">TODAY'S MISSION</span>
        <h2 id="today-mission-title">Win today’s content sprint</h2>
        <p id="today-mission-summary">Loading today’s progress…</p>
      </div>
      <div id="today-status-grid" class="today-status-grid"></div>
    </section>

    <!-- KPI Metric Cards Grid -->
    <div id="kpi-grid" class="metrics-grid">
      <!-- Injected dynamically -->
    </div>

    <!-- Empty State for KPIs -->
    <div id="kpi-empty" class="empty-state" style="display: none; margin-bottom: 1.25rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
      <p style="font-size: 0.875rem; font-weight: 600;">No KPI metrics returned by backend.</p>
    </div>

    <!-- Dual Column Grid: Action Queue & Pipeline Breakdown -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem; align-items: start;">
      <!-- Action Queue -->
      <div class="card" style="align-self: start;">
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--brand-600);"></div>
            <h2 class="card-title">Action Queue</h2>
          </div>
          <span id="action-queue-count" class="chip chip-rose" style="font-size: 0.75rem;">0 Items</span>
        </div>
        <div class="card-body" style="padding: 0;">
          <div id="action-queue-container" style="display: flex; flex-direction: column; max-height: 440px; overflow-y: auto;">
            <!-- Queue items -->
          </div>
          <div id="action-queue-empty" class="empty-state" style="padding: 2.5rem 1rem;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <p style="font-size: 0.875rem; font-weight: 500;">Action queue is clear. No overdue or blocked tasks.</p>
          </div>
        </div>
      </div>

      <!-- Pipeline / Stage Breakdown -->
      <div class="card" style="align-self: start;">
        <div class="card-header">
          <h2 class="card-title">Pipeline Breakdown</h2>
        </div>
        <div class="card-body">
          <div id="pipeline-stages-container" style="display: flex; flex-direction: column; gap: 0.875rem;">
            <!-- Stage bars -->
          </div>
          <div id="pipeline-empty" class="empty-state" style="padding: 2.5rem 1rem;">
            <p style="font-size: 0.875rem; font-weight: 500;">No pipeline status data returned.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Drawer Component -->
  <VideoDetailDrawer />

  <script is:inline>
    async function loadDashboardData() {
      const skeletons = document.getElementById('dashboard-skeletons');
      const content = document.getElementById('dashboard-content');
      const errorBox = document.getElementById('dashboard-error');
      const errorText = document.getElementById('dashboard-error-text');
      const lastUpdatedEl = document.getElementById('last-updated-text');

      if (skeletons) skeletons.style.display = 'block';
      if (content) content.style.display = 'none';
      if (errorBox) errorBox.style.display = 'none';

      try {
        const res = await fetch('/api/infinity', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'dashboard' })
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.ok === false) {
          throw new Error(data.error || 'Failed to fetch dashboard data');
        }

        renderDashboard(data);

        if (lastUpdatedEl) {
          const d = new Date();
          lastUpdatedEl.textContent = `Updated ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        }

        if (skeletons) skeletons.style.display = 'none';
        if (content) content.style.display = 'block';
      } catch (err) {
        if (skeletons) skeletons.style.display = 'none';
        if (errorBox) {
          if (errorText) errorText.textContent = err.message || 'Failed to communicate with operations backend.';
          errorBox.style.display = 'block';
        }
      }
    }

    function renderDashboard(raw) {
      const root = raw || {};
      const data = root.result || root.data || root;

      renderTodayMission(data);

      // 1. Render KPIs
      const kpiGrid = document.getElementById('kpi-grid');
      const kpiEmpty = document.getElementById('kpi-empty');
      if (kpiGrid) {
        kpiGrid.innerHTML = '';
        let renderedCount = 0;

        const addMetricCard = (label, val, badgeClass) => {
          if (val === undefined || val === null) return;
          renderedCount++;
          const card = document.createElement('div');
          card.className = `metric-card ${badgeClass}`;
          card.innerHTML = `
            <div class="metric-label">${label}</div>
            <div class="metric-value">${val}</div>
          `;
          kpiGrid.appendChild(card);
        };

        // Standard KPIs returned by backend
        addMetricCard('Active Pipeline', data.totalActive, 'badge-rose');
        addMetricCard('Planned Today', data.plannedToday, 'badge-blue');
        addMetricCard('Overdue', data.overdue, 'badge-red');
        addMetricCard('Blocked', data.blocked, 'badge-red');

        // By Status KPIs
        const byStatus = data.byStatus || data.statusBreakdown || {};
        if (typeof byStatus === 'object') {
          if (byStatus['Editing'] !== undefined) addMetricCard('In Editing', byStatus['Editing'], 'badge-amber');
          if (byStatus['QC Pending'] !== undefined) addMetricCard('QC Pending', byStatus['QC Pending'], 'badge-purple');
          if (byStatus['Script Ready'] !== undefined) addMetricCard('Script Ready', byStatus['Script Ready'], 'badge-blue');
          if (byStatus['Changes'] !== undefined) addMetricCard('Changes Required', byStatus['Changes'], 'badge-rose');
          if (byStatus['Approved'] !== undefined) addMetricCard('Ready to Post', byStatus['Approved'], 'badge-emerald');
          if (byStatus['Uploaded'] !== undefined) addMetricCard('Uploaded', byStatus['Uploaded'], 'badge-emerald');
          if (byStatus['Unassigned'] !== undefined) addMetricCard('Unassigned', byStatus['Unassigned'], 'badge-rose');
        }

        if (kpiEmpty) {
          kpiEmpty.style.display = renderedCount === 0 ? 'block' : 'none';
        }
      }

      // 2. Render Action Queue
      const queueContainer = document.getElementById('action-queue-container');
      const queueEmpty = document.getElementById('action-queue-empty');
      const queueCount = document.getElementById('action-queue-count');

      const rawQueue = data.actionItems || data.actionQueue || data.urgentTasks || [];

      if (queueContainer) {
        queueContainer.innerHTML = '';
        if (Array.isArray(rawQueue) && rawQueue.length > 0) {
          if (queueEmpty) queueEmpty.style.display = 'none';
          if (queueCount) queueCount.textContent = `${rawQueue.length} Items`;

          rawQueue.forEach(item => {
            const id = item.videoId || item.id || '—';
            let title = item.scriptPreview || item.title || item.topic || 'Untitled Video';
            if (title.includes('\n')) {
              title = title.split('\n')[0].trim();
            }

            const status = item.productionStatus || item.status || 'Action Required';
            const sla = item.slaStatus || item.sla;
            const editor = item.editor;
            const due = item.dueAt || item.dueDate;

            const row = document.createElement('div');
            row.style.cssText = 'padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background var(--trans-fast); gap: 0.75rem;';
            row.onmouseover = () => { row.style.background = 'var(--brand-50)'; };
            row.onmouseout = () => { row.style.background = 'transparent'; };
            row.onclick = () => {
              if (id !== '—' && typeof window.openVideoDrawer === 'function') {
                window.openVideoDrawer(id);
              }
            };

            row.innerHTML = `
              <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span class="font-mono" style="font-size: 0.75rem; font-weight: 700; color: var(--brand-700); flex-shrink: 0;">${id}</span>
                  <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${title}</span>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; gap: 0.75rem; flex-wrap: wrap;">
                  ${editor ? `<span>Editor: <strong>${editor}</strong></span>` : '<span style="color: var(--brand-700);">Unassigned</span>'}
                  ${sla ? `<span class="chip ${sla.toLowerCase().includes('overdue') ? 'chip-red' : 'chip-default'}" style="font-size: 0.6875rem; padding: 0.05rem 0.35rem;">${sla}</span>` : ''}
                  ${due ? `<span>Due: ${due}</span>` : ''}
                </div>
              </div>
              <span class="chip ${status.toLowerCase().includes('qc') ? 'chip-purple' : status.toLowerCase().includes('editing') ? 'chip-amber' : 'chip-blue'}" style="font-size: 0.75rem; flex-shrink: 0;">${status}</span>
            `;
            queueContainer.appendChild(row);
          });
        } else {
          if (queueEmpty) queueEmpty.style.display = 'flex';
          if (queueCount) queueCount.textContent = '0 Items';
        }
      }

      // 3. Render Pipeline Stages
      const pipelineContainer = document.getElementById('pipeline-stages-container');
      const pipelineEmpty = document.getElementById('pipeline-empty');
      const byStatus = data.byStatus || data.statusBreakdown || {};

      if (pipelineContainer) {
        pipelineContainer.innerHTML = '';
        const stages = Object.entries(byStatus).map(([stage, count]) => ({
          stage,
          count: Number(count || 0)
        }));

        if (stages.length > 0) {
          if (pipelineEmpty) pipelineEmpty.style.display = 'none';
          const maxCount = Math.max(...stages.map(s => s.count), 1);

          stages.forEach(st => {
            const percent = Math.round((st.count / maxCount) * 100);
            const row = document.createElement('div');
            row.style.cssText = 'display: flex; flex-direction: column; gap: 0.25rem;';
            row.innerHTML = `
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem;">
                <span style="font-weight: 600; color: var(--text-main);">${st.stage}</span>
                <span style="font-weight: 700; color: var(--text-main);">${st.count}</span>
              </div>
              <div style="height: 6px; background-color: var(--bg-subtle); border-radius: var(--radius-full); overflow: hidden;">
                <div style="height: 100%; width: ${percent}%; background-color: var(--brand-600); border-radius: var(--radius-full);"></div>
              </div>
            `;
            pipelineContainer.appendChild(row);
          });
        } else {
          if (pipelineEmpty) pipelineEmpty.style.display = 'flex';
        }
      }
    }

    function renderTodayMission(data) {
      const grid = document.getElementById('today-status-grid');
      const summary = document.getElementById('today-mission-summary');
      if (!grid) return;

      const today = data.todayByStatus || data.todayStatus || {};
      const planned = Number(data.plannedToday || data.todayTotal || 0);
      const uploaded = Number(today.Uploaded || data.todayUploaded || 0);
      const stages = [
        ['Script', Number(today['Script Pending'] || 0)],
        ['Ready', Number(today['Script Ready'] || 0)],
        ['Editing', Number(today.Editing || 0)],
        ['QC', Number(today['QC Pending'] || 0)],
        ['Changes', Number(today.Changes || 0)],
        ['Uploaded', uploaded]
      ];

      grid.innerHTML = stages.map(([label, value]) => `
        <div class="today-status-item ${label === 'Uploaded' && value > 0 ? 'is-complete' : ''}">
          <strong>${value}</strong><span>${label}</span>
        </div>
      `).join('');

      const percent = planned > 0 ? Math.min(100, Math.round((uploaded / planned) * 100)) : 0;
      if (summary) summary.textContent = planned
        ? `${uploaded}/${planned} videos uploaded · ${percent}% mission complete`
        : 'No videos planned for today yet.';
    }

    // Set refresh hook
    window.__refreshOperationsData = loadDashboardData;

    // Initial load
    document.addEventListener('DOMContentLoaded', () => {
      loadDashboardData();
    });
  </script>
</Layout>
