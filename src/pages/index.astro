---
import Layout from '../layouts/Layout.astro';
import VideoDetailDrawer from '../components/VideoDetailDrawer.astro';
---

<Layout title="Control Tower" activeTab="dashboard">
  <!-- Error Banner -->
  <div id="dashboard-error" class="error-state" style="display: none; margin-bottom: 1.5rem;">
    <div style="font-weight: 700; font-size: 0.95rem;">Unable to load dashboard data</div>
    <p id="dashboard-error-text" style="font-size: 0.8125rem; margin-top: 0.25rem;">Failed to communicate with operations backend.</p>
    <button class="btn btn-primary btn-sm" onclick="loadDashboardData()" style="margin-top: 0.5rem;">
      Retry Connection
    </button>
  </div>

  <!-- Loading Skeletons -->
  <div id="dashboard-skeletons" style="display: block;">
    <div class="metrics-grid">
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
      <div class="skeleton skeleton-metric"></div>
    </div>
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
      <div class="card" style="padding: 1.5rem; height: 280px;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text"></div>
        <div class="skeleton skeleton-text"></div>
      </div>
      <div class="card" style="padding: 1.5rem; height: 280px;">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text"></div>
      </div>
    </div>
  </div>

  <!-- Dynamic Dashboard Content -->
  <div id="dashboard-content" style="display: none;">
    <!-- KPI Metric Cards Grid -->
    <div id="kpi-grid" class="metrics-grid">
      <!-- Injected dynamically -->
    </div>

    <!-- Empty State for KPIs -->
    <div id="kpi-empty" class="empty-state" style="display: none; margin-bottom: 1.5rem; background: #fff; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
      <p style="font-size: 0.875rem; font-weight: 600;">No KPI metrics returned by backend.</p>
    </div>

    <!-- Dual Column Grid: Action Queue & Pipeline Breakdown -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem;">
      <!-- Action Queue -->
      <div class="card">
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--brand-600);"></div>
            <h2 class="card-title">Action Queue</h2>
          </div>
          <span id="action-queue-count" class="chip chip-rose" style="font-size: 0.75rem;">0 Items</span>
        </div>
        <div class="card-body" style="padding: 0;">
          <div id="action-queue-container" style="display: flex; flex-direction: column;">
            <!-- Queue items -->
          </div>
          <div id="action-queue-empty" class="empty-state" style="padding: 2.5rem 1rem;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--text-subtle);">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
              <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            <p style="font-size: 0.875rem; font-weight: 500;">Action queue is clear. No overdue or blocked tasks.</p>
          </div>
        </div>
      </div>

      <!-- Pipeline / Stage Breakdown -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Pipeline Breakdown</h2>
        </div>
        <div class="card-body">
          <div id="pipeline-stages-container" style="display: flex; flex-direction: column; gap: 0.875rem;">
            <!-- Stage bars -->
          </div>
          <div id="pipeline-empty" class="empty-state" style="padding: 2.5rem 1rem;">
            <p style="font-size: 0.875rem; font-weight: 500;">No pipeline status data returned.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Drawer Component -->
  <VideoDetailDrawer />

  <script is:inline>
    async function loadDashboardData() {
      const skeletons = document.getElementById('dashboard-skeletons');
      const content = document.getElementById('dashboard-content');
      const errorBox = document.getElementById('dashboard-error');
      const errorText = document.getElementById('dashboard-error-text');
      const lastUpdatedEl = document.getElementById('last-updated-text');

      if (skeletons) skeletons.style.display = 'block';
      if (content) content.style.display = 'none';
      if (errorBox) errorBox.style.display = 'none';

      try {
        // First try 'dashboard', fallback to 'bootstrap'
        let res = await fetch('/api/infinity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'dashboard' })
        });

        let data = await res.json().catch(() => ({}));

        if (!res.ok || data.ok === false) {
          // Attempt bootstrap action
          res = await fetch('/api/infinity', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'bootstrap' })
          });
          data = await res.json().catch(() => ({}));
        }

        if (!res.ok || data.ok === false) {
          throw new Error(data.error || 'Failed to fetch dashboard data');
        }

        renderDashboard(data);

        if (lastUpdatedEl) {
          const d = new Date();
          lastUpdatedEl.textContent = `Updated ${d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        }

        if (skeletons) skeletons.style.display = 'none';
        if (content) content.style.display = 'block';
      } catch (err) {
        if (skeletons) skeletons.style.display = 'none';
        if (errorBox) {
          if (errorText) errorText.textContent = err.message || 'Failed to communicate with operations backend.';
          errorBox.style.display = 'block';
        }
      }
    }

    function renderDashboard(raw) {
      const root = raw || {};
      const data = root.data || root.result || root;

      // 1. Render KPIs
      const kpiGrid = document.getElementById('kpi-grid');
      const kpiEmpty = document.getElementById('kpi-empty');
      if (kpiGrid) {
        kpiGrid.innerHTML = '';

        const candidateKeys = [
          { key: 'plannedToday', label: 'Planned Today', badge: 'badge-blue', keys: ['plannedToday', 'planned_today', 'planned', 'today'] },
          { key: 'editing', label: 'Editing', badge: 'badge-amber', keys: ['editing', 'in_editing', 'inEditing', 'editingCount'] },
          { key: 'qcPending', label: 'QC Pending', badge: 'badge-purple', keys: ['qcPending', 'qc_pending', 'inQc', 'in_qc', 'qc'] },
          { key: 'changes', label: 'Changes Requested', badge: 'badge-rose', keys: ['changes', 'changesRequested', 'changes_requested', 'revisions'] },
          { key: 'approved', label: 'Approved', badge: 'badge-emerald', keys: ['approved', 'approvedCount', 'ready_upload'] },
          { key: 'uploaded', label: 'Uploaded', badge: 'badge-emerald', keys: ['uploaded', 'uploadedCount', 'published', 'completed'] },
          { key: 'overdue', label: 'Overdue', badge: 'badge-red', keys: ['overdue', 'overdueCount', 'delayed'] },
          { key: 'blocked', label: 'Blocked', badge: 'badge-red', keys: ['blocked', 'blockedCount', 'stuck'] }
        ];

        const source = data.kpis || data.metrics || data.summary || data;
        let renderedCount = 0;

        if (typeof source === 'object' && source !== null) {
          for (const item of candidateKeys) {
            let val;
            for (const k of item.keys) {
              if (source[k] !== undefined && source[k] !== null && source[k] !== '') {
                val = source[k];
                break;
              }
            }

            if (val !== undefined) {
              renderedCount++;
              const card = document.createElement('div');
              card.className = `metric-card ${item.badge}`;
              card.innerHTML = `
                <div class="metric-label">${item.label}</div>
                <div class="metric-value">${val}</div>
              `;
              kpiGrid.appendChild(card);
            }
          }

          // Custom array kpis if provided
          if (Array.isArray(data.kpis)) {
            data.kpis.forEach(k => {
              if (k && typeof k === 'object' && k.label && k.value !== undefined) {
                renderedCount++;
                const card = document.createElement('div');
                card.className = 'metric-card';
                card.innerHTML = `
                  <div class="metric-label">${k.label}</div>
                  <div class="metric-value">${k.value}</div>
                `;
                kpiGrid.appendChild(card);
              }
            });
          }
        }

        if (kpiEmpty) {
          kpiEmpty.style.display = renderedCount === 0 ? 'block' : 'none';
        }
      }

      // 2. Render Action Queue
      const queueContainer = document.getElementById('action-queue-container');
      const queueEmpty = document.getElementById('action-queue-empty');
      const queueCount = document.getElementById('action-queue-count');

      const rawQueue = data.actionQueue || data.action_queue || data.queue || data.urgentTasks || [];

      if (queueContainer) {
        queueContainer.innerHTML = '';
        if (Array.isArray(rawQueue) && rawQueue.length > 0) {
          if (queueEmpty) queueEmpty.style.display = 'none';
          if (queueCount) queueCount.textContent = `${rawQueue.length} Items`;

          rawQueue.forEach(item => {
            const id = item.id || item.videoId || item.video_id || '—';
            const title = item.title || item.topic || item.name || 'Untitled';
            const type = item.type || item.reason || item.status || 'Action';
            const editor = item.editor || item.assignedTo;
            const due = item.due || item.dueDate || item.sla;

            const row = document.createElement('div');
            row.style.cssText = 'padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background var(--trans-fast);';
            row.onmouseover = () => { row.style.background = 'var(--brand-50)'; };
            row.onmouseout = () => { row.style.background = 'transparent'; };
            row.onclick = () => {
              if (id !== '—' && typeof window.openVideoDrawer === 'function') {
                window.openVideoDrawer(id);
              }
            };

            row.innerHTML = `
              <div style="display: flex; flex-direction: column; gap: 2px;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span class="font-mono" style="font-size: 0.75rem; font-weight: 700; color: var(--brand-700);">${id}</span>
                  <span style="font-size: 0.8125rem; font-weight: 600; color: var(--text-main);">${title}</span>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-muted); display: flex; gap: 0.75rem;">
                  ${editor ? `<span>Editor: ${editor}</span>` : ''}
                  ${due ? `<span>Due: ${due}</span>` : ''}
                </div>
              </div>
              <span class="chip chip-rose" style="font-size: 0.75rem;">${type}</span>
            `;
            queueContainer.appendChild(row);
          });
        } else {
          if (queueEmpty) queueEmpty.style.display = 'flex';
          if (queueCount) queueCount.textContent = '0 Items';
        }
      }

      // 3. Render Pipeline Stages
      const pipelineContainer = document.getElementById('pipeline-stages-container');
      const pipelineEmpty = document.getElementById('pipeline-empty');
      const rawPipeline = data.pipeline || data.statusBreakdown || data.status_breakdown || data.stages;

      if (pipelineContainer) {
        pipelineContainer.innerHTML = '';
        let stages = [];

        if (Array.isArray(rawPipeline)) {
          stages = rawPipeline.map(st => ({
            stage: st.stage || st.status || st.name || 'Stage',
            count: Number(st.count || st.total || st.value || 0)
          }));
        } else if (typeof rawPipeline === 'object' && rawPipeline !== null) {
          stages = Object.entries(rawPipeline).map(([stage, count]) => ({
            stage,
            count: Number(count || 0)
          }));
        }

        if (stages.length > 0) {
          if (pipelineEmpty) pipelineEmpty.style.display = 'none';
          const maxCount = Math.max(...stages.map(s => s.count), 1);

          stages.forEach(st => {
            const percent = Math.round((st.count / maxCount) * 100);
            const row = document.createElement('div');
            row.style.cssText = 'display: flex; flex-direction: column; gap: 0.25rem;';
            row.innerHTML = `
              <div style="display: flex; justify-content: space-between; font-size: 0.8125rem;">
                <span style="font-weight: 600; color: var(--text-main);">${st.stage}</span>
                <span style="font-weight: 700; color: var(--text-muted);">${st.count}</span>
              </div>
              <div style="height: 6px; background-color: var(--bg-subtle); border-radius: var(--radius-full); overflow: hidden;">
                <div style="height: 100%; width: ${percent}%; background-color: var(--brand-600); border-radius: var(--radius-full);"></div>
              </div>
            `;
            pipelineContainer.appendChild(row);
          });
        } else {
          if (pipelineEmpty) pipelineEmpty.style.display = 'flex';
        }
      }
    }

    // Set refresh hook
    window.__refreshOperationsData = loadDashboardData;

    // Initial load
    document.addEventListener('DOMContentLoaded', () => {
      loadDashboardData();
    });
  </script>
</Layout>
