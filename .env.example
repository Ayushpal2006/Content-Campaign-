# Infinity Operations Backend Configuration (Server-Side Only)
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/your-deployment-id/exec
INFINITY_API_TOKEN=your-infinity-api-token
APP_ACCESS_CODE=your-app-access-code
SESSION_SECRET=your-32-char-session-secret-key-here
INFINITY_USE_MOCKS=false
INFINITY_READ_CACHE_SECONDS=30

# Infinity Operations v2 (safe for browser use; never add a Supabase secret/service-role key here)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
